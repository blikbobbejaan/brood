;; std/crypto.blsp — symmetric encryption, key derivation, secure random bytes.
;;
;; Raw-byte operations return and accept `bytes` values; the byte-consuming
;; primitives also leniently accept a vector or list of ints 0–255.
;; Use `encoding/base64-encode` / `encoding/hex-encode` to serialise keys/nonces.

(defmodule crypto
  "Authenticated encryption (ChaCha20-Poly1305), PBKDF2 key derivation, cryptographically
secure random bytes, signatures (ed25519, ECDSA P-256/P-384, RSA PKCS#1 v1.5 and PSS), X25519
key agreement and Argon2id password hashing.


    ;; generate a random 32-byte key and 12-byte nonce
    (def key   (crypto/random-bytes 32))
    (def nonce (crypto/random-bytes 12))

    ;; encrypt/decrypt
    (def ct (crypto/encrypt key nonce (string/->bytes \"hello\")))
    (def pt (crypto/decrypt key nonce ct))
    (string/bytes-> pt)   ;; => \"hello\"

    ;; derive a key from a password + salt
    (def salt   (crypto/random-bytes 16))
    (def dk     (crypto/pbkdf2 \"my-password\" salt 600000 32))

    ;; constant-time equality check (for HMACs/tags)
    (crypto/constant-time-equal? tag1 tag2)")

;; ---- random bytes -----------------------------------------------------------

(defn random-bytes (n)
  "Return `n` cryptographically secure random bytes as a bytes value.

    (count (crypto/random-bytes 8))   ;=> 8"
  (%random-bytes n))

(defn random-key ()
  "Generate a random 32-byte key suitable for ChaCha20-Poly1305.

    (count (crypto/random-key))   ;=> 32"
  (%random-bytes 32))

(defn random-nonce ()
  "Generate a random 12-byte nonce suitable for ChaCha20-Poly1305.

    (count (crypto/random-nonce))   ;=> 12"
  (%random-bytes 12))

;; ---- byte/string conversion -------------------------------------------------

;; UTF-8 string<->bytes conversion is a general string op and lives in `string`
;; (`string/->bytes` / `string/bytes->`), not here (ADR-234).

;; ---- ChaCha20-Poly1305 AEAD -------------------------------------------------
;;
;; ChaCha20-Poly1305 is an authenticated encryption with additional data (AEAD)
;; cipher. It provides both confidentiality and integrity. A failed decryption
;; means the ciphertext was tampered with or the wrong key/nonce was used.
;;
;; Key: exactly 32 bytes. Nonce: exactly 12 bytes.
;; Ciphertext length = plaintext length + 16 (Poly1305 authentication tag).
;; NEVER reuse the same (key, nonce) pair — use a fresh random nonce each time.

(defn encrypt (key nonce plaintext-bytes)
  "Encrypt `plaintext-bytes` with ChaCha20-Poly1305. `key` must be 32 bytes;
`nonce` must be 12 bytes. Returns ciphertext as a byte vector (plaintext +
16-byte auth tag). Inputs may be bytes values or vectors/lists of ints.
Never reuse a (key, nonce) pair.

    (count (crypto/encrypt (crypto/random-key) (crypto/random-nonce) [1 2 3]))   ;=> 19"
  (%chacha20-encrypt key nonce plaintext-bytes))

(defn decrypt (key nonce ciphertext-bytes)
  "Decrypt `ciphertext-bytes` with ChaCha20-Poly1305. Returns the plaintext
byte vector on success, or `:error` if authentication fails (wrong key/nonce
or tampered ciphertext). Inputs may be bytes values or vectors/lists of ints.

    (let (k (crypto/random-key) n (crypto/random-nonce)) (vec (crypto/decrypt k n (crypto/encrypt k n [1 2 3]))))           ;=> [1 2 3]
    (let (n (crypto/random-nonce)) (crypto/decrypt (crypto/random-key) n (crypto/encrypt (crypto/random-key) n [1 2 3])))   ;=> :error"
  (%chacha20-decrypt key nonce ciphertext-bytes))

(defn encrypt-string (key nonce s)
  "Encrypt the UTF-8 bytes of string `s`. Returns a ciphertext bytes value.

    (count (crypto/encrypt-string (crypto/random-key) (crypto/random-nonce) \"hi\"))   ;=> 18"
  (encrypt key nonce (string/->bytes s)))

(defn decrypt-string (key nonce ciphertext-bytes)
  "Decrypt to a string. Returns the decoded string, or `:error` on failure.

    (let (k (crypto/random-key) n (crypto/random-nonce)) (crypto/decrypt-string k n (crypto/encrypt-string k n \"hi\")))   ;=> \"hi\""
  (let (pt (decrypt key nonce ciphertext-bytes))
    (if (= pt :error) :error (string/bytes-> pt))))

;; ---- PBKDF2-HMAC-SHA256 key derivation --------------------------------------
;;
;; Derive a fixed-length key from a password + random salt. The salt must be
;; stored alongside the derived key (it's not secret). Use iterations ≥ 600,000
;; for password storage (NIST SP 800-132 2023 recommendation).

(defn- crypto-as-bytes (x)
  "Coerce `x` to bytes: a string → its UTF-8 bytes value; bytes / a byte
vector/list → itself. Lets the raw-byte crypto primitives accept either shape."
  (if (string? x) (string/->bytes x) x))

(defn pbkdf2 (password salt iterations key-len)
  "Derive a `key-len`-byte key from `password` and `salt` (each a string or a
byte sequence) using PBKDF2-HMAC-SHA256, returned as a bytes value. A byte salt
is used as raw bytes — so a base64-decoded binary salt (e.g. Postgres SCRAM)
round-trips faithfully rather than being UTF-8-decoded. Higher `iterations` =
slower brute force; use ≥ 600,000 for password storage.

    (encoding/hex-encode-bytes (crypto/pbkdf2 \"password\" \"salt\" 1 32))   ;=> \"120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b\""
  (%pbkdf2-sha256-bytes (crypto-as-bytes password)
    (crypto-as-bytes salt)
    iterations
    key-len))

;; ---- utilities --------------------------------------------------------------

(defn constant-time-equal? (a b)
  "Constant-time equality check for byte sequences (prevents timing attacks).
Returns true if `a` and `b` are identical, false otherwise.

The `bytes` case indexes with `bytes/at` (not the generic `get`, which dispatches on the
collection kind per call) rather than zipping, which would allocate a pair per byte.
Anything not `bytes` — a vector of ints, say — takes a zipped path.

Constant time either way: the loop visits every byte with no early exit, accumulating with
`bit/or`; the `bytes?` test is on the TYPE and the length check on the length, neither of
which is secret.

    (crypto/constant-time-equal? [1 2 3] [1 2 3])   ;=> true
    (crypto/constant-time-equal? [1 2 3] [1 2 4])   ;=> false"
  (let (n (count a))
    (and (= n (count b))
      (if (and (bytes? a) (bytes? b))
        ;; A `letrec` closure over `a`/`b`/`n`, threading only the two changing values: a
        ;; top-level helper would pass five arguments per byte and lose the gain.
        (letrec (go (fn (i acc)
                      (if (>= i n)
                        acc
                        (go (+ i 1) (bit/or acc (bit/xor (bytes/at a i) (bytes/at b i)))))))
          (= 0 (go 0 0)))
        (= 0
          (fold (seq/zip (seq a) (seq b))
            0
            (fn (acc pair) (bit/or acc (bit/xor (first pair) (second pair))))))))))

;; --- ed25519 signatures (ADR-212) ------------------------------------------
;; Public-key signatures: a private seed signs a message, the matching public key verifies
;; it. Package signing (std/tool/package) signs a release's sha256 checksum with the
;; publisher's key and TOFU-verifies it on install. Serialise keys/signatures with
;; `encoding/hex-encode` for on-disk storage or transport.

(defn keypair ()
  "A fresh ed25519 keypair as `{:public <bytes> :private <bytes>}` — `:public` the 32-byte
verifying key (safe to publish), `:private` the 32-byte signing seed (keep secret).

    (count (get (crypto/keypair) :public))   ;=> 32"
  (let ([public private] (%ed25519-keygen)) {:public public :private private}))

(defn sign (private message)
  "The 64-byte ed25519 signature of `message` (bytes) under the 32-byte `private` seed.

    (count (crypto/sign (get (crypto/keypair) :private) (string/->bytes \"m\")))   ;=> 64"
  (%ed25519-sign private message))

(defn verify (public message signature)
  "True when `signature` (64 bytes) is a valid ed25519 signature of `message` under the
32-byte `public` key. Never errors — a malformed or wrong signature is simply false, so it
reads as a plain predicate.

    (let (kp (crypto/keypair) m (string/->bytes \"m\")) (crypto/verify (get kp :public) m (crypto/sign (get kp :private) m)))                  ;=> true
    (let (kp (crypto/keypair)) (crypto/verify (get kp :public) (string/->bytes \"m\") (crypto/sign (get kp :private) (string/->bytes \"n\"))))   ;=> false"
  (%ed25519-verify public message signature))

;; --- ECDSA, RSA, X25519, Argon2id (ADR-448) --------------------------------
;; What a token, a webhook or an identity provider signs with (JWT ES256 / RS256 / PS256,
;; OIDC, WebAuthn), the key agreement a protocol derives a session key from, and the
;; memory-hard hash a stored password wants. A key is a map; a message is bytes. ECDSA and
;; RSA are native-only (they raise on wasm32); X25519 and Argon2id work everywhere.

(defn ecdsa-keypair (&optional (curve :p256))
  "A fresh ECDSA keypair on `curve` (`:p256`, the default, or `:p384`) as
`{:curve :public :private}` — `:public` the uncompressed point (65 / 97 bytes, safe to
publish), `:private` a PKCS#8 document (keep secret).

    (count (get (crypto/ecdsa-keypair) :public))   ;=> 65"
  (let ([public private] (%ecdsa-keygen curve)) {:curve curve :public public :private private}))

(defn ecdsa-sign (key message)
  "The ECDSA signature of `message` (bytes) under `key` (an `ecdsa-keypair`), hashed with
SHA-256 on P-256 and SHA-384 on P-384, in the fixed r‖s form JWT's ES256 / ES384 use
(64 / 96 bytes).

    (count (crypto/ecdsa-sign (crypto/ecdsa-keypair) (string/->bytes \"m\")))   ;=> 64"
  (%ecdsa-sign (get key :curve :p256) (get key :private) message))

(defn ecdsa-verify (key message signature)
  "True when `signature` (fixed r‖s) is a valid ECDSA signature of `message` under `key` —
a map with `:curve` and `:public`, which a keypair is. Never errors: a malformed key or a
wrong signature is false.

    (let (kp (crypto/ecdsa-keypair :p384) m (string/->bytes \"m\")) (crypto/ecdsa-verify kp m (crypto/ecdsa-sign kp m)))   ;=> true"
  (%ecdsa-verify (get key :curve :p256) (get key :public) message signature))

(defn rsa-keypair (&optional (bits 2048))
  "A fresh RSA key of `bits` (2048 by default; 3072, 4096 or 8192) as `{:n :e :private}` —
the public key as its big-endian modulus and exponent (a JWK's `n` and `e`), the private key
a PKCS#8 document.

    (count (get (crypto/rsa-keypair) :n))   ;=> 256"
  (let ([n e private] (%rsa-keygen bits)) {:n n :e e :private private}))

(defn rsa-sign (key message &optional (scheme :pkcs1-sha256))
  "The RSA signature of `message` (bytes) under `key` (an `rsa-keypair`), by `scheme`:
`:pkcs1-sha256` (JWT RS256, the default), `:pkcs1-sha384`, `:pkcs1-sha512`, or the PSS
schemes `:pss-sha256` (PS256), `:pss-sha384`, `:pss-sha512`.

    (count (crypto/rsa-sign (crypto/rsa-keypair) (string/->bytes \"m\")))   ;=> 256"
  (%rsa-sign scheme (get key :private) message))

(defn rsa-verify (key message signature &optional (scheme :pkcs1-sha256))
  "True when `signature` is a valid RSA signature of `message` by `scheme` under `key` — a
map with `:n` and `:e`, as an `rsa-keypair` or a decoded JWK gives them. Never errors.

    (let (kp (crypto/rsa-keypair) m (string/->bytes \"m\")) (crypto/rsa-verify kp m (crypto/rsa-sign kp m :pss-sha256) :pss-sha256))   ;=> true"
  (%rsa-verify scheme (get key :n) (get key :e) message signature))

(defn x25519-keypair ()
  "A fresh X25519 keypair as `{:public :private}`, 32 bytes each.

    (count (get (crypto/x25519-keypair) :public))   ;=> 32"
  (let ([public private] (%x25519-keygen)) {:public public :private private}))

(defn x25519-shared (private their-public)
  "The 32-byte secret our `private` key shares with the holder of `their-public` — each side
computes the same one from its own private key and the other's public key. Derive a key from
it (HKDF); never use it as one.

    (let (a (crypto/x25519-keypair) b (crypto/x25519-keypair)) (= (crypto/x25519-shared (get a :private) (get b :public)) (crypto/x25519-shared (get b :private) (get a :public))))   ;=> true"
  (%x25519-shared private their-public))

(defn password-hash (password)
  "An Argon2id hash of `password` (a string or bytes) to store: a PHC string that carries its
own random salt and cost (`$argon2id$v=19$m=…`). Check a login with `password-verify`.

    (string/starts-with? (crypto/password-hash \"hunter2\") \"$argon2id$\")   ;=> true"
  (%argon2id-hash (if (string? password) (string/->bytes password) password)))

(defn password-verify (phc password)
  "True when `password` (a string or bytes) is the one the stored `phc` string was hashed
from. Never errors — a string that is no Argon2 hash is false.

    (crypto/password-verify (crypto/password-hash \"hunter2\") \"hunter2\")   ;=> true
    (crypto/password-verify \"not a hash\" \"hunter2\")   ;=> false"
  (%argon2id-verify phc (if (string? password) (string/->bytes password) password)))
