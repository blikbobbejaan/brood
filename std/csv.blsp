;; std/csv.blsp — CSV decoding and encoding, written entirely in Brood.

(defmodule csv
  "CSV decoding and encoding, written entirely in Brood (pure; opt-in).

    (csv/decode \"a,b\\n1,2\")
    ;; => ([\"a\" \"b\"] [\"1\" \"2\"])   — a list of rows, each a VECTOR of strings
    (csv/decode-maps \"name,age\\nAlice,30\")
    ;; => ({\"name\" \"Alice\" \"age\" \"30\"})
    (csv/encode '((\"a\" \"b\") (\"1\" \"2\")))
    ;; => \"a,b\\n1,2\"
    (csv/encode-maps '({\"name\" \"Alice\" \"age\" \"30\"}) [\"name\" \"age\"])
    ;; => \"name,age\\nAlice,30\"

Quoted fields may contain commas, newlines, and escaped quotes (\"\").
Both \\n and \\r\\n line endings are accepted on input; \\n is emitted. Malformed
input — a quoted field that never closes, or text after a closing quote — raises,
as `json/decode` does, rather than decoding to rows that look right and aren't.")

;; ---- decoding ---------------------------------------------------------------
;;
;; A state machine over a CODE-POINT VECTOR (O(1) `nth`; `char-at` on a UTF-8 string is
;; O(i)). States: `:unquoted` (an unquoted field, or the start of any field), `:quoted`,
;; and `:quote-seen` (a quote inside a quoted field: `""` or the closing quote). A field
;; is a REVERSED char list, joined once at its end; `row` is a vector of finished fields.

(defn- at (s i n)
  (if (< i n) (nth s i) nil))

(defn- end-field (row field)
  (conj row (apply str (reverse field))))

(defn- parse (s i n state field row rows)
  (let (c (at s i n)
        ;; a CR is a line break only as half of CRLF; a bare one is data
        crlf (and (= c "\r") (= (at s (+ i 1) n) "\n")))
    (cond
      (= state :quoted)
        (cond
          (nil? c) (error "csv/decode: unterminated quoted field")
          (= c "\"") (parse s (+ i 1) n :quote-seen field row rows)
          ;; everything else, CR and LF included, is content (RFC 4180 §2.6)
          else (parse s (+ i 1) n :quoted (cons c field) row rows))
      ;; nothing since the last line break: a trailing newline, not an empty row
      (nil? c)
        (if (and (= state :unquoted) (nil? field) (empty? row))
          (reverse rows)
          (reverse (cons (end-field row field) rows)))
      (and (= state :quote-seen) (= c "\"")) (parse s (+ i 1) n :quoted (cons c field) row rows)
      (= c ",") (parse s (+ i 1) n :unquoted nil (end-field row field) rows)
      (or crlf (= c "\n"))
        (parse s (if crlf (+ i 2) (+ i 1)) n :unquoted nil [] (cons (end-field row field) rows))
      ;; RFC 4180 §2.7: only a separator may follow a closing quote
      (= state :quote-seen)
        (error "csv/decode: unexpected " (pr-str c) " after a closing quote at index " i)
      (and (nil? field) (= c "\"")) (parse s (+ i 1) n :quoted nil row rows)
      else (parse s (+ i 1) n :unquoted (cons c field) row rows))))

(defn decode (s)
  "Parse a CSV string → a list of rows, where each row is a vector of strings.
Handles quoted fields (which may contain commas and newlines), `\"\"` as an
escaped quote inside a quoted field, and both `\\n` and `\\r\\n` line endings.
An empty string returns an empty list. Malformed input — a quoted field that never
closes, or anything but a separator after a closing quote — **raises**.

    (csv/decode \"a,b\n1,2\")   → ([\"a\" \"b\"] [\"1\" \"2\"])"
  (let (chars (into [] (string/->list s)))
    (parse chars 0 (count chars) :unquoted nil [] nil)))

(defn decode-maps (s)
  "Parse a CSV string where the first row is a header row. Returns a list of
maps from header→value strings. An empty or header-only CSV returns nil/empty;
malformed input raises, as `decode` does."
  (let (rows (decode s)
        headers (first rows))
    (map (rest rows)
      (fn (row)
        (fold (range (count headers)) {} (fn (m i) (assoc m (nth headers i) (nth row i ""))))))))

;; ---- encoding ---------------------------------------------------------------

(defn- emit-field (v)
  "One CSV field, quoted when it holds a comma, quote, CR or LF, interior quotes doubled. A
non-string cell is rendered with `->string` (the `Display` protocol) first."
  (let (s (if (string? v) v (->string v)))
    (if (any? ["," "\"" "\n" "\r"] (fn (special) (includes? s special)))
      (str "\"" (string/replace s "\"" "\"\"") "\"")
      s)))

(defn encode (rows)
  "Serialize a list of rows (each a list or vector of cells) to a CSV string. A cell that
is not a string is rendered with `->string` (so a number, keyword, or record emits its
display form).
Fields containing commas, quotes, or newlines are quoted; interior quotes are
doubled. Rows are separated by `\\n`.

    (csv/encode [[\"a\" \"b\"]])   → \"a,b\""
  (string/join (map rows (fn (row) (string/join (map row emit-field) ","))) "\n"))

(defn- cell (m h)
  ;; Presence, not truthiness: a stored `false` emits `false`; a key holding nil, or
  ;; absent, emits an empty field.
  (let (k (if (contains? m h) h (keyword h))
        v (get m k))
    (if (nil? v) "" v)))

(defn encode-maps (maps:seqable headers:any -> string)
  "Serialize a list of maps to CSV, with the given `headers` list determining
column order. The header row is written first. Missing keys produce empty fields.

    (csv/encode-maps (list {:a 1 :b \"x\"} {:a 2}) [\"a\" \"b\"])   → \"a,b\\n1,x\\n2,\""
  (encode (cons headers (map maps (fn (m) (map headers (fn (h) (cell m h))))))))
