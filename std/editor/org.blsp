;; std/editor/org.blsp — lexical Org highlighting and the outline beneath it.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - `editor/markdown`'s shape for Org: pure, line-oriented, `[start end face]` spans in the
;;    `highlight-spans` shape, so it is a `:fontify` service as it stands. The one piece of
;;    state carried between lines is "inside a #+BEGIN_ … #+END_ block".
;;  - Faces are `editor/face` names resolved when the spans are built, not colours: a theme
;;    switch restyles an Org buffer on its next frame, as it does a tree-sitter one.
;;  - The OUTLINE is here too — a line's heading level, where a subtree ends, the TODO cycle
;;    — because those are facts about Org text, and an editor's folding, promote/demote and
;;    `C-c C-t` should not each re-derive them.
;;  - The inline markup is one `regex/tokens` table, scanned natively. Org's rule that an
;;    emphasis marker opens only after a space or punctuation is checked on the token after
;;    the scan (the native engine has no look-behind), which is what keeps the `/b/` in
;;    `http://a/b/c` from turning italic.

(defmodule editor/org
  "Lexical Org-mode syntax highlighting, and the outline beneath it, as pure functions
over text:

  - `(org-spans src)` — `[start end face]` colour spans (ascending, non-overlapping,
    end-exclusive): headings by level, TODO / DONE keywords, priorities and tags,
    `#+KEYWORD:` lines, `#+BEGIN_ … #+END_` blocks, comments, drawers, list bullets and
    checkboxes, links, timestamps and the six emphasis markers.
  - `(heading-level line)` — the number of stars a heading line opens with, or nil.
  - `(subtree-end lines index)` — the last line of the subtree under the heading at
    `index`: the line before the next heading at its level or above, else the last line.
  - `(cycle-todo line)` — the heading line with its TODO keyword stepped
    none → TODO → DONE → none (Org's `C-c C-t`)."
  (:use editor/face))

;; ---- the outline ---------------------------------------------------------------

(defn- count-stars (line i)
  (if (and (< i (string/length line)) (= (string/char-at line i) "*")) (count-stars line (inc i)) i))

(defn heading-level (line)
  "The level of an Org heading line — its leading stars, which a space must follow — or
nil when `line` is not a heading.

    (editor/org/heading-level \"** Notes\")   → 2
    (editor/org/heading-level \"*bold* text\")   → nil"
  (let (stars (count-stars line 0))
    (if (and (> stars 0) (< stars (string/length line)) (= (string/char-at line stars) " "))
      stars
      nil)))
(sig heading-level (string -> (or nil int)))

(defn- subtree-end-from (lines level i)
  (cond
    (>= i (count lines)) (dec (count lines))
    (let (other (heading-level (nth lines i))) (and other (<= other level))) (dec i)
    else (subtree-end-from lines level (inc i))))

(defn subtree-end (lines index)
  "The last line of the subtree under the heading at `index` of `lines`: the line before
the next heading at its level or above, else the last line. `index` itself when it is not
a heading.

    (editor/org/subtree-end [\"* a\" \"text\" \"** b\" \"* c\"] 0)   → 2"
  (let (level (heading-level (nth lines index "")))
    (if (nil? level) index (subtree-end-from lines level (inc index)))))
(sig subtree-end (any int -> int))

(def todo-keywords ["TODO" "NEXT" "WAITING" "HOLD"])
(def done-keywords ["DONE" "CANCELLED" "CANCELED"])

(sig keyword-after-stars (string int -> (or nil string)))
(defn- keyword-after-stars (line stars)
  ;; the TODO / DONE keyword right after a heading's stars, or nil
  (let (rest (string/substring line (inc stars) (string/length line))
        word (first (string/split rest " ")))
    (when (or (includes? todo-keywords word) (includes? done-keywords word)) word)))

(defn cycle-todo (line)
  "`line`, a heading, with its keyword stepped none → TODO → DONE → none (Org's `C-c C-t`);
any other line unchanged.

    (editor/org/cycle-todo \"* Write it\")        → \"* TODO Write it\"
    (editor/org/cycle-todo \"* TODO Write it\")   → \"* DONE Write it\"
    (editor/org/cycle-todo \"* DONE Write it\")   → \"* Write it\""
  (let (stars (heading-level line))
    (if (nil? stars)
      line
      (let (prefix (string/substring line 0 (inc stars))
            word (keyword-after-stars line stars)
            title (if (nil? word)
                    (string/substring line (inc stars) (string/length line))
                    (string/triml (string/substring line
                                    (+ stars 1 (string/length word))
                                    (string/length line)))))
        (cond
          (nil? word) (str prefix "TODO " title)
          (includes? todo-keywords word) (str prefix "DONE " title)
          else (str prefix title))))))
(sig cycle-todo (string -> string))

;; ---- faces -----------------------------------------------------------------------

;; A heading's face by level, cycling as Org's `org-level-N` faces do.
(def- heading-face-names [:syntax/function :syntax/keyword :syntax/special :syntax/string])

(defn- faces ()
  ;; resolved once per `org-spans` call, so a theme switch reaches the next frame
  {:heading (map heading-face-names (fn (name) (merge (face name) {:bold true})))
   :todo (merge (face :syntax/error) {:bold true})
   :done (merge (face :syntax/string) {:bold true})
   :priority (face :syntax/special)
   :tag (face :syntax/doc)
   :meta (face :syntax/comment)
   :keyword (face :syntax/keyword)
   :keyword-value (face :syntax/doc)
   :block (face :syntax/string)
   :comment (face :syntax/comment)
   :bullet (face :syntax/number)
   :checkbox (face :syntax/special)
   :link (merge (face :syntax/function) {:underline true})
   :timestamp (face :syntax/number)
   :bold {:bold true}
   :italic {:italic true}
   :underline {:underline true}
   :verbatim (face :syntax/string)
   :code (face :syntax/string)
   :strike (face :syntax/comment)})

;; ---- inline markup -----------------------------------------------------------------

(def- inline-rules
  (regex/tokenizer [["\\[\\[[^\\]]+\\](\\[[^\\]]*\\])?\\]" :link]
                     ["[<\\[]\\d{4}-\\d{2}-\\d{2}[^>\\]]*[>\\]]" :timestamp]
                     ["\\*[^\\s*]([^*]*[^\\s*])?\\*" :bold]
                     ["/[^\\s/]([^/]*[^\\s/])?/" :italic]
                     ["_[^\\s_]([^_]*[^\\s_])?_" :underline]
                     ["=[^\\s=]([^=]*[^\\s=])?=" :verbatim]
                     ["~[^\\s~]([^~]*[^\\s~])?~" :code]
                     ["\\+[^\\s+]([^+]*[^\\s+])?\\+" :strike]]))

(def- emphasis-tags #{:bold :italic :underline :verbatim :code :strike})

(defn- word-char? (c) (regex/matches? "[A-Za-z0-9]" c))

(defn- standalone? (text token)
  ;; Org's rule: an emphasis marker opens after the start, a space or punctuation, and
  ;; closes before the end, a space or punctuation — never inside a word
  (let (start (get token :start)
        end (get token :end))
    (and (int? start)
      (int? end)
      (or (= start 0) (not (word-char? (string/char-at text (dec start)))))
      (or (>= end (string/length text)) (not (word-char? (string/char-at text end)))))))

(defn- inline-spans (text base from fs acc)
  ;; the inline tokens of `text` from char `from`, as spans offset by `base`, onto `acc`
  ;; newest first
  (let (rest (string/substring text from (string/length text)))
    (fold (regex/tokens inline-rules rest)
      acc
      (fn (spans token)
        (let (tag (get token :tag)
              shifted (assoc token
                        :start (+ from (get token :start))
                        :end (+ from (get token :end))))
          (if (and (contains? emphasis-tags tag) (not (standalone? text shifted)))
            spans
            (cons [(+ base (get shifted :start)) (+ base (get shifted :end)) (get fs tag)] spans)))))))

;; ---- one line ----------------------------------------------------------------------

(defn- lead (line) (- (string/length line) (string/length (string/triml line))))

(sig heading-spans (string int int map list -> list))
(defn- heading-spans (line base stars fs acc)
  ;; stars and title in the level's face, the keyword, priority and tags in their own
  (let (level-face (nth (get fs :heading) (math/mod (dec stars) 4))
        word (keyword-after-stars line stars)
        after-word (if (nil? word) (inc stars) (+ stars 1 (string/length word)))
        tags (regex/find "\\s(:[A-Za-z0-9_@#%:]+:)\\s*$" line)
        title-end (if tags (get (first (get tags :groups)) :start) (string/length line))
        priority (regex/find "^\\s*\\[#[A-Z0-9]\\]" (string/substring line after-word title-end))
        with-stars (cons [base (+ base stars) level-face] acc)
        with-word (if (nil? word)
                    with-stars
                    (cons [(+ base stars 1)
                            (+ base stars 1 (string/length word))
                            (if (includes? done-keywords word) (get fs :done) (get fs :todo))]
                      with-stars))
        title-start (if priority (+ after-word (get priority :end)) after-word)
        with-priority (if priority
                        (cons [(+ base after-word (get priority :start))
                                (+ base title-start)
                                (get fs :priority)]
                          with-word)
                        with-word)
        with-title (if (< title-start title-end)
                     (cons [(+ base title-start) (+ base title-end) level-face] with-priority)
                     with-priority))
    (if tags
      (let (group (first (get tags :groups)))
        (cons [(+ base (get group :start)) (+ base (get group :end)) (get fs :tag)] with-title))
      with-title)))

(defn- list-spans (line base fs acc)
  ;; a list item: its bullet, a checkbox after it, and the item's inline markup — or nil
  ;; when the line is not one
  (let (bullet (regex/find "^\\s*([-+]|\\d+[.)])\\s" line))
    (when bullet
      (let (group (first (get bullet :groups))
            with-bullet (cons [(+ base (get group :start))
                                (+ base (get group :end))
                                (get fs :bullet)]
                          acc)
            after (get bullet :end)
            box (regex/find "^\\[[ X-]\\]" (string/substring line after (string/length line)))
            with-box (if box
                       (cons [(+ base after) (+ base after (get box :end)) (get fs :checkbox)]
                         with-bullet)
                       with-bullet))
        (inline-spans line base (if box (+ after (get box :end)) after) fs with-box)))))

(defn- line-spans (line base block? fs acc)
  "`[spans-newest-first block?']` for one line of Org at offset `base`, `block?` saying
whether a #+BEGIN_ block is open above it."
  (let (trimmed (string/triml line)
        upper (string/upper trimmed)
        level (heading-level line)
        whole (fn (face) (if (= line "") acc (cons [base (+ base (string/length line)) face] acc))))
    (cond
      block?
        (if (string/starts-with? upper "#+END_")
          [(whole (get fs :meta)) false]
          [(whole (get fs :block)) true])
      (string/starts-with? upper "#+BEGIN_") [(whole (get fs :meta)) true]
      (int? level) [(heading-spans line base level fs acc) false]
      ;; `#+TITLE: Notes` — the keyword, then its value
      (regex/match? "^#\\+[A-Za-z_]+:" trimmed)
        (let (colon (+ (lead line) (index-of trimmed ":") 1))
          [(cons [(+ base colon) (+ base (string/length line)) (get fs :keyword-value)]
             (cons [(+ base (lead line)) (+ base colon) (get fs :keyword)] acc))
            false])
      (or (= trimmed "#") (string/starts-with? trimmed "# ")) [(whole (get fs :comment)) false]
      ;; a drawer's fences — `:PROPERTIES:`, `:END:` — and the properties between them
      (regex/match? "^:[A-Za-z_-]+:" trimmed) [(whole (get fs :meta)) false]
      else [(or (list-spans line base fs acc) (inline-spans line base 0 fs acc)) false])))

(defn- lex-lines (lines base block? fs acc)
  (if (empty? lines)
    (reverse acc)
    (let (line (first lines)
          [spans block-after] (line-spans line base block? fs acc))
      (lex-lines (rest lines) (+ base (string/length line) 1) block-after fs spans))))

(defn org-spans (src)
  "`[start end face]` colour spans for the Org text `src` — ascending, non-overlapping,
end-exclusive, the `highlight-spans` shape, so it is a `:fontify` service as it stands.
Faces are `editor/face` names resolved now, so the next call after a theme switch uses
the new one.

    (count (editor/org/org-spans \"* TODO Write it :work:\"))   → 4"
  (lex-lines (string/split src "\n") 0 false (faces) '()))
(sig org-spans (string -> list))
