;; Behaviour contracts — the module-satisfies-a-contract seam. CORE: this is part of
;; the language (loaded in the prelude), so `defbehaviour` and the registry are available
;; without a `require` or a `protocol/` prefix.
;;
;; `defbehaviour` declares the ops a *module* must define to satisfy a named contract.
;; There is no value dispatch: a module satisfies a behaviour by defining functions and
;; calls its own functions directly. It records the ops in `*protocols*` so the advisory
;; checker can verify that a module whose header says `(:implements bname)` defines each
;; one at the right arity (`types/check/protocol.rs`).
;;
;; Value polymorphism lives in `std/ability.blsp` (nominal dispatch). Behaviours stay
;; separate because a module-as-implementor contract — a namespace with no dispatch value, e.g. a
;; live view the router calls by name — is genuinely different from value dispatch.

; ---- the behaviour/interface registry (read by the checker + LSP) ------------

; interface-name → its declared op specs, as DATA. Read it with `reflect/behaviour-ops`
; rather than a bare accessor: `ops` is far too common a local name to own as a global
; (five files in std/ already bind it as a `let`), and reading a registry is tooling.
(defonce *protocols* {})

(defn %register-protocol (pname specs)
  "Record interface `pname`'s declared op specs (raw forms) for the checker / LSP."
  ;; An op, not a swap: a `defprotocol` in a lazily loaded module must survive the
  ;; `%isolate` window its load happened to land in (KI-141; see `editor/face`).
  (%registry-update! '*protocols* :assoc [pname] specs)
  nil)

; ---- the behaviour macro ----------------------------------------------------

(defmacro defbehaviour (bname & specs)
  "Declare a behaviour `bname` — a contract a *module* satisfies by defining its ops as
  functions (unlike a value-dispatched `ability`, there is no runtime dispatch; a module
  calls its own functions directly). Records the ops so the checker can verify a module
  whose header says `(:implements bname)` defines each one at the right arity.

    (defbehaviour LiveModule
      (mount (params))
      (render (model))
      (handle-event (name params model)))

  Each op's parameters are a list, as in the `defn` that will satisfy it (ADR-512)."
  ;; `%filter`, not `seq/filter`: this is a MACRO body, so it runs at expansion time —
  ;; and protocol.blsp is part of the PRELUDE (boot.rs concatenates it last), where no
  ;; module has loaded yet. See the note at `%filter` in prelude/predicates.blsp (ADR-330).
  (let (ops (%filter specs (fn (s) (pair? s))))
    ;; A parameter list is a LIST (ADR-512): a vector was the spelling, and a vector in a
    ;; parameter position destructures (ADR-149), so it is refused with the list it should be.
    (doseq (s ops)
      (when (vector? (second s))
        (error "defbehaviour "
          bname
          ": op `"
          (first s)
          "` takes its parameters as a list, as defn does — write ("
          (first s)
          " "
          (%params-as-list-text (second s))
          "), not "
          (pr-str (second s))
          " (ADR-512)")))
    (list '%register-protocol (list 'quote bname) (list 'quote ops))))
