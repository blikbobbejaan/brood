;; std/term.blsp — the terminal seam (ADR-046 display protocol).
;;
;; Thin policy over the `%term-*` primitives (mechanism): raw-mode + alternate-screen
;; control, input polling, and the two paint frontends (full-screen `draw`, inline
;; `emit`). Kept in the `term` namespace rather than the bare language core — an editor
;; or REPL reaches these as `term/enter`, `term/poll`, `term/draw`, …
(defmodule term
  "The terminal seam: raw mode, the alternate screen, cursor control and key decoding, over the `%term-*` primitives.")

(defn enter ()
  "Enter raw mode + the alternate screen, hide the cursor, and enable mouse capture,
taking over the terminal for a full-screen UI (so click/scroll reach `term/poll`). A
terminal that speaks the kitty keyboard protocol is asked to report repeats and releases
(popped again by `term/leave` and every exit path); in any other a held key is inferred
from its repeats. Either way `term/poll` delivers `[:key-up …]` and `term/held-key` knows
the key held. Pair with `term/leave`.

    (term/enter)   ;=> the terminal taken over: raw mode, alternate screen, mouse capture"
  (%term-enter))

(defn leave ()
  "Restore the terminal: show the cursor, disable mouse capture, leave the alternate
screen, disable raw mode. The normal-path teardown for `term/enter`.

    (term/leave)   ;=> the terminal restored to its normal state"
  (%term-leave))

(defn size ()
  "The terminal size as [cols rows] in character cells.

    (term/size)   ;=> [120 40]"
  (%term-size))

(defn poll (ms)
  "Wait up to `ms` milliseconds for an input event; return a key (a 1-char string for
printables, or a keyword for specials: :up :down :left :right :enter :escape :backspace
:tab :back-tab :delete :home :end :page-up :page-down, ctrl combos like :ctrl-c, alt
combos like :alt-f), a mouse event as a vector [:mouse action button row col mods]
(action: :press :release :drag :scroll-up :scroll-down — :drag is motion with a button
held, reported once per cell crossed; button: :left :right :middle or nil for scroll;
row/col 0-based cells; mods a vector of held modifier keywords in :ctrl :alt :shift order,
[] when none), or nil on timeout. After `term/enter` a key coming up is delivered too, as
`[:key-up press]`, `press` the value that key's press delivered though Ctrl or Shift came
up first: reported by a terminal that speaks the kitty keyboard protocol, and inferred in
any other (tmux, a legacy terminal) when a held key's repeats stop — a held key there is
the same press arriving faster than a hand can press one key, and a tapped key has no
key-up. A held key's repeat already superseded in the buffered input is dropped, so a
backlog never plays on after the key is up; a press is never dropped, nor typed text, which
a paste is made of. `term/held-key` names the key held. Always pass a finite `ms`.

    (term/poll 50)   ;=> \"a\", :ctrl-c, [:mouse :press :left 3 10 []], [:key-up :ctrl-n], or nil on timeout"
  (%term-poll ms))

(defn held-key ()
  "The key held down in the terminal now — the value its press delivered (a 1-char string,
or a keyword like :ctrl-n / :up) — or nil when none is. A terminal that speaks the kitty
keyboard protocol (kitty, foot, WezTerm, Ghostty, Alacritty 0.13+) reports it; in any other,
and for the keys the protocol still sends as text, a key is held once its repeats arrive
faster than a hand presses one key, until they stop. Always nil outside `term/enter`.

    (term/held-key)   ;=> :down while the down arrow is held, nil when no key is"
  (%term-held-key))

(defn draw (frame)
  "Paint a `frame` — a vector of render ops: [:clear], [:text row col str], [:text row col
str face], [:rect row col w h face], [:cursor row col] / [:cursor row col style]. A face is
a map like {:fg :red :bold true}; a colour is a palette keyword (:red … :dark-grey) or an
explicit [r g b] vector / \"#rrggbb\" hex string. [:rect …] fills a w×h cell block with the
face's background. The optional cursor `style` is :block (default), :bar, or :underline. The
in-process frontend for the display protocol; returns nil.

    (term/draw [[:clear] [:text 0 0 \"hello\" {:fg :red}] [:cursor 0 5]])   ;=> nil"
  (%term-draw frame))

(defn raw-enter ()
  "Enter raw mode only — NO alternate screen, cursor stays visible, scrollback preserved.
The seam for an inline line editor (the REPL); use `term/enter` instead for a full-screen
TUI. Pair with `term/raw-leave`.

    (term/raw-enter)   ;=> raw mode on; the screen and scrollback stay in place"
  (%term-raw-enter))

(defn raw-leave ()
  "Leave raw mode (the teardown for `term/raw-enter`). Idempotent with the panic-path restore.

    (term/raw-leave)   ;=> raw mode off"
  (%term-raw-leave))

(defn emit (ops)
  "Paint inline, relative-motion render `ops` (for an in-place editor that must not take
over the screen): [:print str], [:print str face], [:cr], [:nl], [:up n], [:down n],
[:col n], [:clear-eol], [:clear-below], [:clear-screen]. A face is a map like
{:fg :cyan :bold true}. Queues all ops then flushes once; unknown ops are skipped; returns nil.

    (term/emit [[:cr] [:print \"> \" {:fg :cyan}] [:clear-eol]])   ;=> nil"
  (%term-emit ops))
