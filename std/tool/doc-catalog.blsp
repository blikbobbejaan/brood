(defmodule doc-catalog
  "The language reference's categories (math, strings, filesystem, processes, and so on),
  their order and display titles, and `category-of` — the category of any name, DERIVED
  from where the name is defined rather than listed per name. Shared by nest docs --all
  and hive's hosted /reference so both present the language identically.

  The derivation, first match wins:
  - a qualified `mod/name` takes its module's category (`*module-categories*`);
  - a bare prelude name takes the category of the prelude SECTION it is defined in — the
    `;; ---- title ----` header above its definition (`*section-categories*`), so moving a
    definition to another section is how its category changes;
  - a kernel primitive has no Brood definition, so it is placed by `*kernel-categories*`;
  - `*exceptions*` names the few prelude definitions that sit in a section of another
    domain.
  A name none of these place is `:other`; `tests/doc_catalog_test.blsp` keeps that drawer empty
  and checks every table entry still names a real module, section or primitive.")

(def *category-order*
  [[:math "Math and numbers"]
    [:strings "Strings and text"]
    [:collections "Sequences and collections"]
    [:maps "Maps and records"]
    [:sets "Sets"]
    [:bytes "Bytes and binary"]
    [:predicates "Predicates"]
    [:convert "Types and conversion"]
    [:control "Control flow and macros"]
    [:patterns "Pattern matching"]
    [:functions "Functions and combinators"]
    [:io "Input and output"]
    [:filesystem "Filesystem"]
    [:processes "Processes and concurrency"]
    [:errors "Errors"]
    [:meta "Modules and reflection"]
    [:system "System and environment"]
    [:other "Other"]])

;; The kernel-namespaced families of the core reference. Other std modules are documented
;; per module (`nest doc <module>`) and have no category.
(def *module-categories*
  {"bit" :math
   "combinator" :functions
   "decimal" :math
   "file" :filesystem
   "fuzzy" :strings
   "io" :io
   "list" :collections
   "map" :maps
   "math" :math
   "num" :math
   "path" :filesystem
   "proc" :processes
   "reflect" :meta
   "seq" :collections
   "set" :sets
   "string" :strings
   "system" :system})

;; Prelude section -> category. A key is the start of a section header's title (the text
;; after `;; ---- `) and must match exactly one header.
(def *section-categories*
  {"bootstrap:" :control
   "logic" :predicates
   "universal list view" :collections
   "folding" :collections
   "arithmetic" :math
   "comparison & equality" :math
   "control-flow macros" :control
   "checker suppression" :control
   "macro expansion" :meta
   "`type-matches?`" :predicates
   "type predicates" :predicates
   "derived predicates" :predicates
   "sequence operations" :collections
   "list accessors" :collections
   "the compositions of `first` and `rest`" :collections
   "map operations" :maps
   "map: merge" :maps
   "I/O" :io
   "embedding a file's text" :filesystem
   "threading macros" :control
   "conditional threading" :control
   "binding-conditionals" :control
   "with:" :control
   "side-effecting iteration" :control
   "error handling" :errors
   "dynamic variables" :meta
   "case:" :control
   "bytes patterns" :patterns
   "spawn:" :processes
   "receive:" :processes
   "dirty-native offload" :processes
   "sequence library" :collections
   "kept in the prelude" :collections
   "comprehensions" :control
   "records:" :maps
   "lazy / fusing seq-views" :functions
   "bounded printing" :io
   "discovery / introspection" :meta
   "spy:" :meta
   "the general registry update" :meta
   "deprecation" :meta
   "the stdlib image, from the prelude" :meta
   "waiting for someone else's in-flight load" :meta
   "library names the PRELUDE itself references" :meta
   "record identity and library-value predicates" :predicates
   "ability impl registration and dispatch" :meta
   ;; image-install.blsp's header also covers what follows it: contracts.blsp and protocol.blsp.
   "boot-time stdlib image install" :meta})

;; Kernel primitives (and two `defn`s nested in a `let`), which record no definition site.
(def *kernel-categories*
  {"apply" :functions
   "bound?" :meta
   "bytes" :bytes
   "compare" :math
   "cons" :collections
   "demonitor" :processes
   "empty?" :predicates
   "exit" :processes
   "first" :collections
   "keyword" :convert
   "link" :processes
   "monitor" :processes
   "nil?" :predicates
   "pair?" :predicates
   "pr-str" :io
   "range?" :predicates
   "ref" :processes
   "rest" :collections
   "self" :processes
   "send" :processes
   "seqview?" :predicates
   "str" :strings
   "symbol" :convert
   "throw" :errors
   "type-of" :convert
   "unlink" :processes
   "vector" :collections})

;; Prelude definitions that sit in a section of another domain. Kept short: the gate
;; rejects an entry that agrees with its section, and moving the definition (or giving it
;; a section of its own) retires an entry.
(def *exceptions*
  {"check-allow" :meta
   "deftype" :meta
   "meta" :meta
   "sig" :meta
   "->float" :convert
   "->string" :convert
   "identity" :functions
   "last" :collections
   "inspect" :io
   "fields" :maps})

;; `;; ---- title ----`; a bare `;; -----` rule under a file's opening comment is not one.
(defn- header-line? (line)
  (and (string/starts-with? line ";; ---")
    (not (= (string/trim (string/replace line "-" "")) ";;"))))

(defn- header-key? (header key) (includes? header (str "- " key)))

(defn prelude-file ()
  "The path every prelude definition site names, or nil when the image records none.

    (doc-catalog/prelude-file)   ;~> \"…/prelude.blsp\" — or nil"
  (first (%source-location 'defn)))

;; `[line-number header-line]` for every section header of the prelude source, in order.
;; Read once when the module loads: the prelude cannot change under a running image.
(def prelude-headers
  (let (path (prelude-file))
    (when path
      (seq/keep (seq/enumerate (string/split (file/slurp path) "\n"))
        (fn (pair)
          (let ([index line] pair)
            (when (header-line? line) [(inc index) line])))))))

(defn section-of (name)
  "The prelude section header line above bare `name`'s definition, or nil if `name` is not
  defined in the prelude source.

    (doc-catalog/section-of \"fold\")   ;~> \";; ---- folding (the workhorse; …) ----\""
  (let (site (%source-location (string/->symbol name)) file (prelude-file))
    (when (and site file (= (first site) file))
      (fold prelude-headers
        nil
        (fn (found entry) (if (<= (first entry) (second site)) (second entry) found))))))

(defn- section-category (header)
  (when header
    (fold *section-categories*
      nil
      (fn (found pair) (if (header-key? header (first pair)) (second pair) found)))))

(defn derived-category (name)
  "The category `name`'s definition site gives it, ignoring `*exceptions*`, or nil.

    (doc-catalog/derived-category \"string/join\")  ;=> :strings"
  (let (slash (string/last-index-of name "/"))
    (if (> slash 0)
      (get *module-categories* (string/substring name 0 slash))
      (or (section-category (section-of name)) (get *kernel-categories* name)))))

(defn category-of (name)
  "The category keyword for a function name (a string, bare or `mod/name`), or :other when
  nothing places it.

    (doc-catalog/category-of \"string/join\")  ;=> :strings
    (doc-catalog/category-of \"zz-nope\")      ;=> :other"
  (or (get *exceptions* name) (derived-category name) :other))
