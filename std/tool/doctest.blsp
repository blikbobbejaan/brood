;; std/tool/doctest.blsp — a documented example is a promise; run it.
;;
;; An example in a docstring is a claim about behaviour, and a wrong one is worse than no
;; example at all: it reads as authoritative and it is invisible to every other gate — the
;; checker does not evaluate docstrings, and no test covers prose. Two of the first batch
;; written for `std/` were already wrong when this machinery was first applied there.
;;
;; The engine lived as six private functions inside `tests/doc_examples_test.blsp`, hard-wired
;; to `reflect/builtin-modules`, so it could gate the standard library and nothing else. It is the
;; same code here, made public and pointed at whichever names you ask for — which is what
;; `nest test` needs to gate a *project's* docstrings the way this repo gates its own.

(defmodule doctest
  "Run the examples in docstrings and report the ones that do not hold.

The convention, and the one to write new examples in:

    \"…prose…

        (count [1 2 3])   → 3
        (get {:a 1} :zz)  → nil\"

An **indented** line containing ` → ` is a case: the left side is evaluated and must equal
the right. A trailing `; comment` is ignored. Only indented lines count — inline `e.g. …`
prose is left alone deliberately, since much of it names values that do not exist outside
the sentence.

An **illustration** is the same shape with ` ;=> ` in place of the arrow — for a function
whose result depends on the world (a file, the clock, a socket, a pid) and so cannot be
pinned. It is not evaluated, but it is still held to something: its left side must read as
one form, and the function it calls must exist — so a rename or a typo fails here too.

    (file/slurp \"notes.txt\")   ;=> \"…the file's text…\"

    (doctest/failures-under \"myapp/\")   ;; → the examples that do not hold
    (doctest/failures)                    ;; → …across every public name in the image")

(defn- strip-comment (line)
  ;; `line` up to its first `;` that is OUTSIDE a string literal, so `→ :x  ; note`
  ;; compares against `:x` while `→ ("a; b")` keeps its semicolon. Cutting at the first
  ;; `;` unconditionally would truncate such a result into something that no longer reads
  ;; as a value, and the example could only fail.
  (letrec (go (fn (cs i in-string escaped)
                (cond
                  (empty? cs) line
                  escaped (go (rest cs) (+ i 1) in-string false)
                  ;; A backslash escapes the next character, but only inside a string.
                  (= (first cs) "\\") (go (rest cs) (+ i 1) in-string in-string)
                  (= (first cs) "\"") (go (rest cs) (+ i 1) (not in-string) false)
                  (and (= (first cs) ";") (not in-string)) (string/substring line 0 i)
                  :else (go (rest cs) (+ i 1) in-string false))))
    (go (string/->list line) 0 false false)))

(defn- example-line? (l)
  ;; Indented, and carrying the arrow OUTSIDE any trailing comment. Testing the raw line
  ;; instead let a line whose only arrow sits in a comment be selected as an example and then
  ;; silently dropped by `case-of`, which strips the comment first — the two disagreed about
  ;; what an example is, and the disagreement was spent as silence.
  (and (string/starts-with? l "    ") (includes? (strip-comment l) " → ")))

(defn example-lines (d)
  "The indented ` → ` lines of docstring `d` — the example cases it carries."
  (seq/filter (string/split (str d) "\n") example-line?))

(defn- illustration-line? (l)
  ;; Indented, not an executed case, and carrying the ` ;=> ` marker AFTER a form — a line
  ;; that starts with `;` is a result continuing the form on the line above, which is prose.
  (and (string/starts-with? l "    ")
    (not (string/starts-with? (string/trim l) ";"))
    (not (example-line? l))
    (includes? l " ;=> ")))

(defn illustration-lines (d)
  "The indented ` ;=> ` lines of docstring `d` — illustrations: examples that are read and
whose callee must exist, but that are not evaluated.

    (doctest/illustration-lines (doc file/slurp))   ;=> (…its illustration lines…)

    (count (doctest/illustration-lines \"x\\n    (file/slurp \\\"a\\\")   ;=> \\\"…\\\"\"))   → 1"
  (seq/filter (string/split (str d) "\n") illustration-line?))

(defn- check-illustration (name-str line)
  ;; nil when the illustration reads as one form whose head is bound or a special form.
  (let (src (string/trim (first (string/split line " ;=> ")))
        ;; check-allow :discarded-catch — a form that does not read is the failure reported below
        parsed (check-allow :discarded-catch (try [:ok (reflect/read-string src)] (catch _ nil)))
        form (if parsed (second parsed) nil)
        head (if (pair? form) (first form) nil))
    (cond
      (nil? parsed) (str name-str ": " src "  ;=> illustration does not read as one form")
      (and (symbol? head)
        (not (bound? head))
        (not (includes? (reflect/special-forms) (->string head))))
        (str name-str ": " src "  ;=> illustration calls `" head "`, which is not defined")
      else nil)))

(defn- case-of (line)
  ;; `[source expected]` for one example line, or nil when it does not split cleanly.
  (let (parts (string/split (strip-comment line) " → "))
    (when (= 2 (count parts))
      [(string/trim (first parts)) (string/trim (or (second parts) ""))])))

(defn- holds? (value expected)
  ;; Does `value` satisfy the documented result text `expected`?
  ;;
  ;; Compared as a VALUE when `expected` reads as one, and only then as text. A printed map
  ;; or set is in the trie's order, and that order depends on the ids the symbol interner
  ;; handed out — so it moves when anything else in the image changes, *including adding an
  ;; unrelated kernel primitive*. That is how this fired once: `%codepoints->string` shifted
  ;; the interning and `(seq/frequencies [:a :b :a])` began printing `{:a 2, :b 1}` where the
  ;; docstring recorded the equally-correct `{:b 1, :a 2}`. The same example passed when
  ;; evaluated on its own, which is the tell that the comparison and not the example was
  ;; wrong.
  ;;
  ;; Reading rather than evaluating is deliberate: a documented list result is written
  ;; `(:a :b)`, which as a *form* would call `:a`. Read, it is the list value it depicts.
  ;; Anything that does not read — `#<fn>`, a `RAISED …` line — falls back to comparing
  ;; `pr-str`, so nothing is silently accepted.
  ;; check-allow :discarded-catch — an expected value that does not read falls back to a pr-str comparison
  (let (parsed (check-allow :discarded-catch
                 (try [:ok (reflect/read-string expected)] (catch _ nil))))
    (if parsed (= value (second parsed)) (= (pr-str value) expected))))

(defn check (name-str line)
  "nil when `line` is not an example at all, or when the example it carries holds; else a
description of how it failed — a wrong result, a line that looks like an example and does
not parse as one, or an illustration (` ;=> `) that does not read or calls nothing defined.

`name-str` only labels the message — it is the name the example was found on.

    (doctest/check \"x\" \"plain prose\")  → nil"
  (if (illustration-line? line)
    (check-illustration name-str line)
    (when (example-line? line)
      (let (c (case-of line))
        (if (nil? c)
          ;; Selected as an example — indented, with an arrow outside any comment — but it does
          ;; not split. That is a MALFORMED example, not prose, and saying so is the difference
          ;; between an unchecked promise and a known one. Silence here is how a typo'd second
          ;; arrow removes a case from the gate without anyone noticing.
          (str name-str ": " (string/trim line) "  → malformed example: expected exactly one ` → `")
          (let ([src expected] c
                outcome (try
                          [:ok (reflect/eval (reflect/read-string src))]
                          (catch e [:raised (str "RAISED " (error-message e))]))
                ok (if (= (first outcome) :raised)
                     (= (second outcome) expected)
                     (holds? (second outcome) expected)))
            (when (not ok)
              (str name-str
                ": "
                src
                "  → got "
                (if (= (first outcome) :raised) (second outcome) (pr-str (second outcome)))
                ", documented "
                expected))))))))

(defn- documented? (s)
  ;; check-allow :discarded-catch — an expected value that does not read falls back to a pr-str comparison
  (let (d (check-allow :discarded-catch (try (doc (reflect/eval s)) (catch _ nil))))
    (and d (or (not (empty? (example-lines d))) (not (empty? (illustration-lines d)))))))

(defn documented-names-under (prefix)
  "Every public name starting with `prefix` whose docstring carries at least one indented
example — `\"myapp/\"` for one package's own surface. A nil `prefix` means every public name."
  ;; Narrow by PREFIX before looking for examples, not after: `documented?` evaluates a
  ;; global to read its docstring, so filtering last makes a scoped run pay that for every
  ;; one of the thousands of names it is about to discard.
  (let (public (seq/filter (reflect/global-names) (fn (s) (not (reflect/private? s))))
        scoped (if (nil? prefix)
                 public
                 (seq/filter public (fn (s) (string/starts-with? (->string s) prefix)))))
    (seq/filter scoped documented?)))

(defn documented-names ()
  "Every public name in the image whose docstring carries at least one indented example."
  (documented-names-under nil))

(defn- failures-of (s)
  (let (d (doc (reflect/eval s)))
    (seq/filter (map (append (example-lines d) (illustration-lines d))
                  (fn (l) (check (->string s) l)))
      (fn (x) (not (nil? x))))))

(defn failures-under (prefix)
  "Every documented example that does not hold, for public names under `prefix` (nil = the
whole image). A vector of descriptions, empty when every example holds — the caller decides
whether that is a failure, so this is usable as a report as well as a gate."
  (apply vector
    (fold (documented-names-under prefix) [] (fn (acc s) (append acc (failures-of s))))))

(defn failures ()
  "Every documented example in the image that does not hold."
  (failures-under nil))
