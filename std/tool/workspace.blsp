;; workspace — drive every Brood repo in the workspace with one command.
;;
;; Drives `nest ws`. The Brood ecosystem is many sibling git repos (brood, hatch, hive,
;; bedit, pong, …); an ecosystem-wide change means the same check → commit → push in each.
;; A sibling counts when it has a `.git` dir AND a `project.blsp`. Every command runs with an
;; explicit argv and working directory — no shell. Nothing here force-pushes, resets,
;; stashes, or checks out.
(defmodule workspace
  "Drive every Brood repo in the workspace with one command — what `nest ws` runs. Discovers
  the sibling repos of the current directory and fans a check, commit or push out across
  them."
  (:use file))

(defn- brood-repos (parent)
  (seq/filter (sort (map (file/ls parent) (fn (name) (path/join parent name))))
    (fn (dir)
      (and (file/dir? (path/join dir ".git")) (file/exists? (path/join dir "project.blsp"))))))

(defn- repo-name (dir) (path/basename dir))

(defn- git-out (dir git-args)
  "Trimmed stdout of `git -C dir <git-args…>`."
  (string/trim (get (os/cmd "git" (cons "-C" (cons dir git-args))) :stdout)))

(defn- git-run (dir git-args)
  "Run `git -C dir <git-args…>` inheriting stdio; returns the exit code."
  (os/run-process "git" (cons "-C" (cons dir git-args))))

(defn- dirty-count (dir)
  (count (seq/reject (string/split (git-out dir (list "status" "--short")) "\n") string/blank?)))

(defn- ahead-count (dir)
  (let (ahead (git-out dir (list "rev-list" "--count" "@{u}..HEAD")))
    (if (string/blank? ahead) "0" ahead)))

(defn- failed (dir step)
  "Report that `step` failed in `dir`; one failure to count."
  (io/puts (str "  " step " FAILED: " (repo-name dir)) :to *err*)
  1)

(defn- fan-out (parent step)
  "Run `step` (dir → failure count) over every repo under `parent`; the total failures."
  (fold (brood-repos parent) 0 (fn (failures dir) (+ failures (step dir)))))

(defn- check-repo (dir)
  (io/puts "=== " (repo-name dir) " ===")
  ;; `nest check` reads the project of its working directory.
  (let (result (os/cmd "nest" ["check"] {:cwd dir}))
    (io/write (get result :stdout))
    (io/write (get result :stderr) :to *err*)
    (if (= (get result :exit) 0) 0 (failed dir "check"))))

(defn- commit-repo (message dir)
  (cond
    (= (dirty-count dir) 0) 0
    (not (= 0 (git-run dir (list "add" "-A")))) (failed dir "git add")
    (not (= 0 (git-run dir (list "commit" "-q" "-m" message)))) (failed dir "git commit")
    else (do (io/puts "committed: " (repo-name dir)) 0)))

(defn- push-repo (dir)
  (cond
    (= (ahead-count dir) "0") 0
    (not (= 0 (git-run dir (list "push")))) (failed dir "git push")
    else (do (io/puts "pushed: " (repo-name dir)) 0)))

(defn run (action message &optional parent)
  "Dispatch for `nest ws <action> [message]` over the git repos with a `project.blsp` under
`parent` (default: the current directory's parent). Returns how many repo steps failed —
`nest ws` exits non-zero when any did."
  (let (parent (or parent (path/dirname (file/cwd))))
    (cond
      (= action "list") (do (doseq (dir (brood-repos parent)) (io/puts (repo-name dir))) 0)
      (= action "status")
        (do
          (doseq (dir (brood-repos parent))
            (let (dirty (dirty-count dir) ahead (ahead-count dir))
              (when (or (> dirty 0) (not (= ahead "0")))
                (io/puts (repo-name dir) "  uncommitted=" dirty " unpushed=" ahead))))
          0)
      (= action "check") (fan-out parent check-repo)
      (= action "commit")
        (if (nil? message)
          (do (io/puts "nest ws commit needs a message" :to *err*) 1)
          (fan-out parent (fn (dir) (commit-repo message dir))))
      (= action "push") (fan-out parent push-repo)
      else
        (do
          (io/puts (str "nest ws: unknown action '" action "' (list|status|check|commit|push)")
            :to *err*)
          1))))
