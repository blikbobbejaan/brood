;; std/vcs.blsp — the version control a directory lives in, whichever one it is.
;;
;; Design notes (the *why*; the *what* is in the docstrings below):
;;  - A project is a git clone or a mur working copy (`.mur/` at its top), and every tool that
;;    asks "which files are the project's", "what did this work change" or "what did this file
;;    say before I touched it" asked git by name: `nest format`'s file list, a package's files,
;;    the build stamp, and bedit's find-file, change gutter and mode line. In a mur working
;;    copy each of those answered nothing. This module is the one place that question is put,
;;    so a second VCS is a row, not an edit to every caller.
;;  - A backend is a ROW in `std/registry` (`:vcs/backends`), its hooks kept as symbols and
;;    called late (`reflect/call-if-bound`), so a package adds a VCS by `registry/put!` and a
;;    redefined hook takes effect on its next call. git and mur are the two rows this module
;;    puts when it loads.
;;  - Only the MECHANISM is here: where the checkout is and the four questions every caller
;;    shares. What a VCS can DO (git's staging, mur's changes, saves and lands) is an editor's
;;    or a tool's porcelain over its own command line, and stays there.
;;  - Every answer is opportunistic: nil when the directory is in no checkout, the program is
;;    not installed, or it fails. A caller falls back (a plain directory walk) rather than
;;    handling an error for "this is not a repository".

(defmodule vcs
  "The version control a directory lives in — git or mur, or another a package registers —
and the questions every tool asks of it: where the checkout's top is ([[locate]]), which
files are the project's ([[files]]), which this work changed ([[changed]]), what a file said
before it was edited ([[base-text]]), and what the tree is at ([[id]])."
  (:use registry)) ; the backend table: a row per VCS, keyed by its kind

;; --- running a VCS's command line ----------------------------------------------------------

(defn- run
  (program:any args: (or list vector) root:string &optional (env:map {}) -> (or string nil))
  "`program`'s stdout for `args`, run in `root` with `env` added — or nil when there is no
such program, it fails, or it exits non-zero."
  (if (nil? program)
    nil
    (let (r (check-allow :discarded-catch
              (try
                (os/cmd program args {:cwd root :env (merge {"GIT_TERMINAL_PROMPT" "0"} env)})
                (catch _ nil))))
      (if (and r (= (get r :exit) 0)) (get r :stdout) nil))))

(defn- lines (out:any -> (or (list string) nil))
  (if (nil? out) nil (seq/reject (string/split out "\n") empty?)))

;; --- git -------------------------------------------------------------------------------------

(defn git-files (root:string -> (or (list string) nil))
  "The files of the git checkout at `root`, root-relative and sorted: tracked, and untracked
but not ignored (`.gitignore`, the global excludes), less the tracked ones deleted from the
work tree. `-z` because without it git writes a non-ASCII name quoted, which no file is
called. nil when git cannot answer.

    (vcs/git-files \"/\")   → nil"
  (let (split (fn (out) (seq/reject (string/split out (string/int->char 0)) empty?))
        listed (run "git" ["ls-files" "-z" "--cached" "--others" "--exclude-standard"] root)
        gone (run "git" ["ls-files" "-z" "--deleted"] root))
    (if (nil? listed)
      nil
      (let (deleted (set/set (if gone (split gone) [])))
        (sort (seq/distinct (seq/reject (split listed) (fn (f) (contains? deleted f)))))))))

(defn git-changed (root:string -> (or (list string) nil))
  "The files this work touches in the git checkout at `root`: the commits not yet upstream
(since the branch left it — `upstream...HEAD`, so commits that landed upstream meanwhile are
not this work; against `origin/main` with no upstream), the index, the work tree and the untracked files —
root-relative, sorted. nil when git cannot answer.

    (vcs/git-changed \"/\")   → nil"
  (let (upstream (or (run "git"
                       ["rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{upstream}"]
                       root)
                   "origin/main")
        asked [(run "git" ["diff" "--name-only" (str (string/trim upstream) "...HEAD")] root)
                (run "git" ["diff" "--name-only" "HEAD"] root)
                (run "git" ["diff" "--name-only" "--cached"] root)
                (run "git" ["ls-files" "--others" "--exclude-standard"] root)])
    (if (every? asked nil?)
      nil
      (sort (seq/distinct (mapcat asked (fn (out) (or (lines out) []))))))))

(defn git-base-text (root:string path:string -> (or string nil))
  "The text of `path` (absolute) at HEAD — what `git diff` compares the working file against.
nil for a file HEAD does not have (a new one) or outside a checkout.

    (vcs/git-base-text \"/\" \"/no-such-file\")   → nil"
  ;; `HEAD:./name` from the file's own directory: git reads `./` against the cwd, so a file in
  ;; a subdirectory needs no root-relative spelling worked out here
  (run "git" ["show" (str "HEAD:./" (path/basename path))] (path/dirname path)))

(defn git-id (root:string -> (or map nil))
  "What the git checkout at `root` is at: `{:id <short sha> :dirty? <work tree differs>}`, or
nil before the first commit or outside a checkout.

    (vcs/git-id \"/\")   → nil"
  (let (sha (run "git" ["rev-parse" "--short=12" "HEAD"] root))
    (if (nil? sha)
      nil
      {:id (string/trim sha)
       :dirty? (not (empty? (string/trim (or (run "git" ["status" "--porcelain"] root) ""))))})))

;; --- mur -------------------------------------------------------------------------------------

(defn mur-program (-> (or string nil))
  "Where the `mur` client is: on `PATH`, else where its installs put it (`~/.local/bin` from
the forge's install script, `~/.cargo/bin` from `make install` in mur) — a desktop launch
often has neither on `PATH`. nil when it is not installed.

    (string? (or (vcs/mur-program) \"\"))   → true"
  (or (os/which "mur")
    (let (home (or (os/env "HOME") "/"))
      (seq/find [(path/join home ".local/bin/mur") (path/join home ".cargo/bin/mur")]
        (fn (candidate) (os/which candidate))))))

;; Which SEAT a mur command speaks as. mur tells the people and agents at work in one working
;; copy apart by where a command comes from: `MUR_AGENT` names an agent, `MUR_RUNNER` a seat,
;; else the terminal it was typed in — and with none of those, `person`, the one seat every
;; terminal-less process shares (a script, an agent's tool calls, an editor). An editor that
;; left it there would move with all of them: their `mur change 2` would move its status, and
;; read as the same runner, its files as theirs. So a program with no terminal of its own names
;; its seat once, and every mur command it runs — these hooks and its own — carries it.

(defn use-mur-seat (name:any -> any)
  "Name the seat (`MUR_RUNNER`) every mur command this program runs speaks as — for one with
no terminal of its own, an editor; nil goes back to mur's own choice. Process-wide (a row in
`std/registry`), so a command a task runs off the loop speaks as the same seat.

    (do (vcs/use-mur-seat \"doc\") (let (env (vcs/mur-env)) (do (vcs/use-mur-seat nil) env)))   → {\"MUR_RUNNER\" \"doc\"}"
  (registry/put! :vcs/settings :mur-seat name))

(defn mur-env (-> map)
  "The environment a mur command runs with: `MUR_RUNNER` set to the seat [[use-mur-seat]]
named, or nothing when none was.

    (map? (vcs/mur-env))   → true"
  (let (seat (registry/lookup :vcs/settings :mur-seat))
    (if (string? seat) {"MUR_RUNNER" seat} {})))

(defn mur-files (root:string -> (or (list string) nil))
  "The files of the mur working copy at `root`, root-relative and sorted (`mur files`: not
ignored, or tracked). nil when mur cannot answer.

    (vcs/mur-files \"/\")   → nil"
  (let (out (lines (run (mur-program) ["files"] root (mur-env)))) (if (nil? out) nil (sort out))))

(defn mur-changed (root:string -> (or (list string) nil))
  "The files the change adds or modifies against trunk, saved or not (`mur files --changed`),
root-relative and sorted. nil when mur cannot answer.

    (vcs/mur-changed \"/\")   → nil"
  (let (out (lines (run (mur-program) ["files" "--changed"] root (mur-env))))
    (if (nil? out) nil (sort out))))

(defn mur-base-text (root:string path:string -> (or string nil))
  "The text of `path` (absolute) as `mur status` and `mur diff` compare it: the change's last
save, else trunk (`mur cat`). nil for a file neither has (a new one).

    (vcs/mur-base-text \"/\" \"/no-such-file\")   → nil"
  (run (mur-program) ["cat" path] root (mur-env)))

(defn mur-id (root:string -> (or map nil))
  "What the mur working copy at `root` is at: `{:id <snapshot> :dirty? <files changed since>}`
from `mur id`, which marks a changed tree with a trailing `+`.

    (vcs/mur-id \"/\")   → nil"
  (let (out (run (mur-program) ["id"] root (mur-env))
        text (and out (string/trim out)))
    (if (or (nil? text) (= text ""))
      nil
      {:id (string/drop-suffix text "+") :dirty? (string/ends-with? text "+")})))

;; --- the backends ----------------------------------------------------------------------------
;; mur ranks before git: where a directory holds both, it is a clone made a mur working copy
;; (`mur init` in it, the way mur starts a project from files you already have), and mur is
;; what the work now goes through.

(registry/put! :vcs/backends
  :git {:rank 20
   :marker ".git" ; a directory in a clone, a file in a worktree or submodule
   :files 'vcs/git-files
   :changed 'vcs/git-changed
   :base-text 'vcs/git-base-text
   :id 'vcs/git-id})

(registry/put! :vcs/backends
  :mur {:rank 10
   :marker ".mur"
   :files 'vcs/mur-files
   :changed 'vcs/mur-changed
   :base-text 'vcs/mur-base-text
   :id 'vcs/mur-id})

(defn backends (-> list)
  "The registered backends as `[kind row]`, in rank order — the order [[locate]] tries them in
one directory. A row is `{:rank :marker :files :changed :base-text :id}`: the marker its
checkout's top holds, and each question as a symbol called with the checkout's root first
(`:base-text` then the file's absolute path). A row may leave a question out: it is nil.

    (map (vcs/backends) first)   → (:mur :git)"
  (map (registry/ranked :vcs/backends) (fn (row) [(first row) (second row)])))

(defn- marked-here (dir:string rows:seqable -> any)
  (seq/find rows (fn (row) (file/exists? (path/join dir (:marker (second row)))))))

(defn- locate-from
  (dir:string rows:seqable limit:int -> (or (record :kind keyword :root string) nil))
  (let (found (marked-here dir rows))
    (cond
      found {:kind (first found) :root dir}
      (or (<= limit 0) (= dir (path/dirname dir))) nil
      :else (locate-from (path/dirname dir) rows (dec limit)))))

(defn locate (dir:string -> (or (record :kind keyword :root string) nil))
  "The checkout `dir` is in: `{:kind :git :root \"/src/app\"}` — the nearest directory, walking
up from `dir` itself, that holds a backend's marker, so a mur working copy inside a git
clone's tree is its own. In one directory with two markers the backend ranked first wins.
nil when `dir` is in none.

    (vcs/locate \"/\")   → nil"
  (locate-from (path/absolute dir) (backends) 64))

(defn kind (dir:string -> (or keyword nil))
  "The kind of checkout `dir` is in (`:git`, `:mur`, …), or nil.

    (vcs/kind \"/\")   → nil"
  (:kind (locate dir)))

(defn root (dir:string -> (or string nil))
  "The top of the checkout `dir` is in, or nil.

    (vcs/root \"/\")   → nil"
  (:root (locate dir)))

(defn- ask (dir:string hook:keyword & args)
  "Put `hook`'s question to the backend of the checkout `dir` is in, its root first and then
`args` — nil outside a checkout, or for a question that backend's row does not answer."
  (let (where (locate dir)
        row (and where (registry/lookup :vcs/backends (:kind where)))
        answers (and row (get row hook)))
    (if (symbol? answers)
      (apply reflect/call-if-bound answers nil (cons (:root where) args))
      nil)))

;; Trusted, not verified: each question is answered by a backend's hook, a symbol called late
;; (`reflect/call-if-bound`), so the checker cannot see its result. The row's hooks are held
;; to these types by the contract `backends` documents: git's and mur's here declare them.
(check-allow :trusted
  (defn files (dir:string -> (or (list string) nil))
    "The files of the checkout `dir` is in, relative to its root and sorted: what the VCS counts
as the project's (tracked, and new files it does not ignore). nil outside a checkout, or when
the VCS cannot answer — walk the directory instead.

    (vcs/files \"/\")   → nil"
    (ask dir :files)))

(check-allow :trusted
  (defn changed (dir:string -> (or (list string) nil))
    "The files the work in progress touches in the checkout `dir` is in, relative to its root:
git's commits not yet upstream and its uncommitted edits, or the mur change's files against
trunk. nil outside a checkout.

    (vcs/changed \"/\")   → nil"
    (ask dir :changed)))

(check-allow :trusted
  (defn base-text (path:string -> (or string nil))
    "What the file at `path` said before the work in progress — the text the VCS compares it
against (git's HEAD, mur's last save) — so an editor can mark the lines changed while the
file is still being typed. nil for a new file, or one in no checkout.

    (vcs/base-text \"/no-such-file\")   → nil"
    (let (absolute (path/absolute path)) (ask (path/dirname absolute) :base-text absolute))))

(check-allow :trusted
  (defn id (dir:string -> (or map nil))
    "What the checkout `dir` is in is at: `{:id <the VCS's short name for it> :dirty? <changed
since>}`, as a build stamp wants it. nil outside a checkout, or before anything is committed.

    (vcs/id \"/\")   → nil"
    (ask dir :id)))
