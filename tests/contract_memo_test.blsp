;; The contract's verdict memo (ADR-480): `type-matches?` remembers a verdict about a
;; compound value by the identity of the type and the value, so an armed `sig` re-checking
;; an unchanged value pays one lookup and a new value with one changed part re-walks only
;; that part. These pin the three things a memo can get wrong: answering from the memo at
;; all, answering for a value it never walked, and answering after the types it walked
;; under changed. The GC half — a slot minted again after a collection or a truncation —
;; is pinned in Rust (`core/heap/gc/tests.rs`), where the collections can be chosen.
(defmodule contract-memo-test
  (:use test))

(deftype memo-buffer (record :name string :lines (vector string)))
(deftype memo-model (record &open :buffers (vector memo-buffer) :point int))

(defn memo-buffer-of (n)
  {:name (str "b" n) :lines ["one" "two" "three"]})

(def memo-model-value
  {:buffers (into [] (map (range 20) memo-buffer-of)) :point 3 :extra :anything})

(defn memo-hits () (:hits (%type-verdict-counts)))

(describe "type-matches? remembers verdicts"
  (test "an unchanged value is answered from the memo"
    (assert (type-matches? 'memo-model memo-model-value))
    (let (before (memo-hits))
      (assert (type-matches? 'memo-model memo-model-value))
      (assert= (inc before) (memo-hits))))
  (test "a new model sharing its buffers re-walks only the top"
    (assert (type-matches? 'memo-model memo-model-value))
    (let (moved (assoc memo-model-value :point 4)
          before (memo-hits))
      (assert (type-matches? 'memo-model moved))
      ;; the `:buffers` vector is the same object: one hit, not twenty walks
      (assert (< 0 (- (memo-hits) before)))))
  (test "a violation deep inside a new value is still caught"
    (assert (type-matches? 'memo-model memo-model-value))
    (let (broken (map/assoc-in memo-model-value [:buffers 7 :lines 1] 42))
      (assert (not (type-matches? 'memo-model broken)))
      ;; and the old value, which shares every other buffer, still passes
      (assert (type-matches? 'memo-model memo-model-value))))
  (test "a closed record still refuses an undeclared key on a new value"
    (assert (type-matches? 'memo-buffer (memo-buffer-of 1)))
    (assert (not (type-matches? 'memo-buffer (assoc (memo-buffer-of 1) :stray 1))))))

(describe "a remembered verdict does not outlive what it was reached under"
  (test "a redefined deftype changes the verdict for the very same value"
    (let (lines ["a" "b"])
      (reflect/eval '(deftype memo-shape (vector string)))
      (assert (type-matches? 'memo-shape lines))
      (reflect/eval '(deftype memo-shape (vector int)))
      (assert (not (type-matches? 'memo-shape lines)))))
  (test "a defrecord turns an unknown name from accepting into a record check"
    (let (plain {:a 1})
      ;; a name nothing defines accepts anything
      (assert (type-matches? 'memo-late-record plain))
      (reflect/eval '(defrecord memo-late-record (a)))
      (assert (not (type-matches? 'memo-late-record plain)))))
  (test "a collection between checks keeps every verdict right"
    (let (good [1 2 3])
      (assert (type-matches? '(vector int) good))
      (dev/gc-collect)
      (assert (type-matches? '(vector int) good))
      (assert (not (type-matches? '(vector int) [1 "two" 3]))))))

;; The kernel decides some forms without the walk (ADR-480): a type variable, an arrow, an
;; `or` of decided alternatives, and a record or vector one level deep when every part is.
;; Each must say exactly what `%type-match` says.
(defrecord memo-defaulted (hits))
(impl Lookup
  memo-defaulted
  ;; an absent key answers 7 through `get`, which only the walk can ask
  (lookup-get (r k) (if (= k :hits) (get r :hits) 7))
  (lookup-keys (r) (list :hits)))

(deftype memo-wants-extra (record &open :extra int))

(describe "forms the kernel decides agree with the walk"
  (test "a type variable accepts, an arrow is fn?"
    (assert (type-matches? '?A 5))
    (assert (type-matches? '(int -> int) inc))
    (assert (not (type-matches? '(int -> int) 5))))
  (test "an or of scalars"
    (assert (type-matches? '(or nil int) nil))
    (assert (type-matches? '(or string nil) "s"))
    (assert (not (type-matches? '(or string nil) 5))))
  (test "a record one level deep, open and closed"
    (assert (type-matches? 'memo-buffer {:name "a" :lines ["x"]}))
    (assert (not (type-matches? 'memo-buffer {:name 1 :lines ["x"]})))
    (assert (not (type-matches? 'memo-buffer {:name "a" :lines ["x"] :more 1})))
    (assert (not (type-matches? 'memo-buffer 5))))
  (test "a record instance's missing field is asked through its Lookup"
    ;; `:extra` is absent from the map; `get` answers 7 through `Lookup`, an int
    (assert (type-matches? 'memo-wants-extra (memo-defaulted 1))))
  (test "a contracted call over the kernel-decided forms still blames a bad argument"
    (reflect/eval '(defn memo-take-buffer (b) 1))
    (reflect/eval '(sig! memo-take-buffer (memo-buffer -> int)))
    (assert= 1 ((reflect/eval 'memo-take-buffer) {:name "a" :lines []}))
    (assert-error ((reflect/eval 'memo-take-buffer) {:name 3 :lines []}))))
