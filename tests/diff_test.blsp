(defmodule diff-test (:use test))

(describe "seq"
  (test "identical sequences"
    (assert= [[:keep 1] [:keep 2] [:keep 3]]
      (into [] (diff/seq [1 2 3] [1 2 3]))))
  (test "empty first"
    (assert= [[:insert :a] [:insert :b]]
      (into [] (diff/seq [] [:a :b]))))
  (test "empty second"
    (assert= [[:delete :a] [:delete :b]]
      (into [] (diff/seq [:a :b] []))))
  (test "both empty"
    (is (nil? (diff/seq [] []))))
  (test "single insertion"
    (let (ops (diff/seq [1 2 3] [1 2 99 3]))
      (is (not (= nil ops)))
      (assert= 1 (get (diff/summary ops) :inserts))
      (assert= 0 (get (diff/summary ops) :deletes))))
  (test "single deletion"
    (let (ops (diff/seq [1 2 3] [1 3]))
      (assert= 0 (get (diff/summary ops) :inserts))
      (assert= 1 (get (diff/summary ops) :deletes))
      (assert= 2 (get (diff/summary ops) :keeps))))
  (test "substitution"
    (let (ops (diff/seq [:a :b :c] [:a :x :c]))
      (assert= 1 (get (diff/summary ops) :inserts))
      (assert= 1 (get (diff/summary ops) :deletes))
      (assert= 2 (get (diff/summary ops) :keeps))))
  (test "works with lists"
    (let (ops (diff/seq '(1 2 3) '(1 3)))
      (assert= 1 (get (diff/summary ops) :deletes)))))

(describe "lines"
  (test "same text"
    (let (ops (diff/lines "a\nb\nc" "a\nb\nc"))
      (assert= 3 (get (diff/summary ops) :keeps))
      (assert= 0 (get (diff/summary ops) :deletes))
      (assert= 0 (get (diff/summary ops) :inserts))))
  (test "one line changed"
    (let (ops (diff/lines "hello\nworld" "hello\nearth"))
      (assert= 1 (get (diff/summary ops) :keeps))
      (assert= 1 (get (diff/summary ops) :deletes))
      (assert= 1 (get (diff/summary ops) :inserts))))
  (test "empty strings"
    (let (ops (diff/lines "" ""))
      (assert= 1 (get (diff/summary ops) :keeps)))))

(describe "summary"
  (test "counts all op types"
    (let (ops '([:keep "a"] [:delete "b"] [:insert "c"] [:keep "d"] [:insert "e"])
          s (diff/summary ops))
      (assert= 2 (get s :keeps))
      (assert= 1 (get s :deletes))
      (assert= 2 (get s :inserts))))
  (test "all keeps"
    (let (s (diff/summary '([:keep 1] [:keep 2])))
      (assert= 2 (get s :keeps))
      (assert= 0 (get s :deletes))
      (assert= 0 (get s :inserts)))))

(describe "patch"
  (test "applies ops to produce b"
    (let (a [1 2 3]
          b [1 99 3]
          ops (diff/seq a b)
          out (diff/patch a ops))
      (assert= [1 99 3] (into [] out))))
  (test "apply to get same sequence"
    (let (a [10 20 30]
          ops (diff/seq a a)
          out (diff/patch a ops))
      (assert= [10 20 30] (into [] out)))))

(describe "unified"
  (test "formats ops with prefixes"
    (let (ops '([:keep "a"] [:delete "b"] [:insert "c"])
          lines (diff/unified ops 0))
      (assert= [" a" "-b" "+c"] (into [] lines)))))

;; ---- reading a unified diff -------------------------------------------------------

(def dt-git-diff
  "diff --git a/src/a.txt b/src/a.txt
index 1111111..2222222 100644
--- a/src/a.txt
+++ b/src/a.txt
@@ -1,4 +1,3 @@ top
 one
-two
+TWO
 three
--- four
@@ -10,2 +10,3 @@
 ten
+ten and a half
 eleven
diff --git a/new.txt b/new.txt
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/new.txt
@@ -0,0 +1 @@
+hello
")

(describe "parse-unified"
  (test "files, paths and hunks"
    (let (files (diff/parse-unified dt-git-diff))
      (assert= 2 (count files))
      (assert= "src/a.txt" (:new-path (first files)))
      (assert= 2 (count (:hunks (first files))))
      (is (nil? (:old-path (second files))))
      (assert= "new.txt" (:new-path (second files)))))
  (test "a removed line that reads like a file header stays in its hunk"
    (let (h (first (:hunks (first (diff/parse-unified dt-git-diff)))))
      (assert= [" one" "-two" "+TWO" " three" "--- four"] (:lines h))
      (assert= "top" (:context h))))
  (test "a commit message above the diff belongs to no file"
    (let (files (diff/parse-unified (str "commit abc\n\n    subject here\n\n" dt-git-diff)))
      (assert= 2 (count files))
      (assert= "diff --git a/src/a.txt b/src/a.txt" (first (:headers (first files))))))
  (test "empty input is no files"
    (assert= [] (diff/parse-unified "")))
  (test "a plain diff -u with timestamps"
    (let (files (diff/parse-unified "--- a.txt\t2026-01-01\n+++ b.txt\t2026-01-02\n@@ -1 +1 @@\n-a\n+b\n"))
      (assert= "a.txt" (:old-path (first files)))
      (assert= "b.txt" (:new-path (first files)))))
  (test "no newline at end of file stays with its line"
    (let (h (first (:hunks (first (diff/parse-unified "--- a/f\n+++ b/f\n@@ -1 +1 @@\n-a\n\\ No newline at end of file\n+a\n")))))
      (assert= ["-a" "\\ No newline at end of file" "+a"] (:lines h)))))

(describe "hunk-patch"
  (test "headers, the one hunk, and a final newline"
    (let (f (first (diff/parse-unified dt-git-diff))
          p (diff/hunk-patch f (second (:hunks f))))
      (is (string/starts-with? p "diff --git a/src/a.txt"))
      (is (string/ends-with? p " eleven\n"))
      (is (not (includes? p "@@ -1,4"))))))

(describe "hunk-select"
  (test "forward: unselected additions go, unselected removals become context"
    (let (h (first (:hunks (first (diff/parse-unified dt-git-diff)))))
      (let (s (diff/hunk-select h 2 3))
        (assert= [" one" " two" "+TWO" " three" " -- four"] (:lines s))
        (assert= "@@ -1,4 +1,5 @@ top" (:header s)))))
  (test "reverse: unselected removals go, unselected additions become context"
    (let (h (first (:hunks (first (diff/parse-unified dt-git-diff)))))
      (let (s (diff/hunk-select h 1 2 true))
        (assert= [" one" "-two" " TWO" " three"] (:lines s))
        (assert= "@@ -1,4 +1,3 @@ top" (:header s)))))
  (test "a range with no change in it is nil"
    (let (h (first (:hunks (first (diff/parse-unified dt-git-diff)))))
      (is (nil? (diff/hunk-select h 0 1))))))

(describe "hunk lines"
  (test "the new-file line of a body line"
    (let (h (second (:hunks (first (diff/parse-unified dt-git-diff)))))
      (assert= 10 (diff/hunk-new-line h 0))
      (assert= 11 (diff/hunk-new-line h 1))
      (assert= 12 (diff/hunk-new-line h 2))))
  (test "a removed line sits where it was removed"
    (let (h (first (:hunks (first (diff/parse-unified dt-git-diff)))))
      (assert= 2 (diff/hunk-new-line h 1))
      (assert= 2 (diff/hunk-old-line h 1))
      (assert= 3 (diff/hunk-old-line h 2)))))

;; ---- the native line diff (ADR-468) -------------------------------------------

(deftype diff-hunk (tuple int int int int))

(defn- diff-rebuild-hunk (old-lines:vector new-lines:vector at:int out:vector hunk:diff-hunk -> any)
  ;; `[at' out']`: `out` with the unchanged lines up to `hunk` and its new lines
  (let ([old-start old-count new-start new-count] hunk)
    [(+ old-start old-count)
      (into (into out (seq/subvec old-lines at old-start))
        (seq/subvec new-lines new-start (+ new-start new-count)))]))

(defn- diff-rebuild (old-lines:vector new-lines:vector hunks:vector)
  ;; `old-lines` with every hunk's new lines put in place of its old ones
  (letrec (walk (fn (at:int out:vector remaining)
                  (if (empty? remaining)
                    (into out (seq/subvec old-lines at (count old-lines)))
                    (let ([next-at next-out] (diff-rebuild-hunk old-lines
                                               new-lines
                                               at
                                               out
                                               (first remaining)))
                      (walk next-at next-out (rest remaining))))))
    (walk 0 [] hunks)))

(describe "line-hunks / line-status"
  (test "identical texts have no hunks, and a lone trailing newline is no change"
    (assert= (diff/line-hunks "a\nb\n" "a\nb\n") [])
    (assert= (diff/line-hunks "a\nb\n" "a\nb") [])
    (assert= (diff/line-hunks "" "") []))

  (test "a replacement, an insertion and a deletion"
    (assert= (diff/line-hunks "a\nb\nc\n" "a\nx\nc\n") [[1 1 1 1]])
    (assert= (diff/line-hunks "a\nc\n" "a\nb\nc\n") [[1 0 1 1]])
    (assert= (diff/line-hunks "a\nb\nc\n" "a\nc\n") [[1 1 1 0]])
    (assert= (diff/line-hunks "" "a\n") [[0 0 0 1]]))

  ;; the placement the indent heuristic exists for: a function added between two
  ;; blank-separated ones is the new function and the blank after it, not the blank above
  ;; it and the tail of the old one
  (test "an added block lands where git puts it"
    (assert= (diff/line-hunks "def a\n  1\nend\n\ndef c\n  3\nend\n"
               "def a\n  1\nend\n\ndef b\n  2\nend\n\ndef c\n  3\nend\n")
      [[4 0 4 4]]))

  ;; the diff alone puts the inserted `x` first in the run (where its search met it); git
  ;; slides a change through a run of equal lines to the run's end, and so does this
  (test "an insertion in a run of equal lines slides to the end of the run"
    (assert= (diff/line-hunks "A\np\nx\nx\nB\n" "C\np\nx\nx\nx\nB\n") [[0 1 0 1] [4 0 4 1]]))

  (test "a rope diffs as its text"
    (let (old "one\ntwo\nthree\n" new "one\n2\nthree\nfour\n")
      (assert= (diff/line-hunks (text/from-string old) (text/from-string new))
        (diff/line-hunks old new))))

  (test "the hunks rebuild the new text, over edits at many places"
    (let (old-lines (into [] (map (range 300) (fn (i) (str "line " (math/mod i 7)))))
          new-lines (-> old-lines
                      (assoc 60 "changed")
                      (seq/remove-nth 150)
                      (assoc 200 "also changed")
                      (seq/subvec 0 280)
                      (into ["tail"]))
          hunks (diff/line-hunks (string/join old-lines "\n") (string/join new-lines "\n")))
      (is (> (count hunks) 2))
      (assert= (diff-rebuild old-lines new-lines hunks) new-lines)))

  (test "line-status reads a hunk as a change gutter does"
    (assert= (diff/line-status "a\nb\nc\n" "a\nx\ny\nc\n") {1 :modified 2 :added})
    (assert= (diff/line-status "a\nb\nc\n" "a\nc\n") {1 :deleted})
    (assert= (diff/line-status "a\n" "a\n") {}))

  :isolated (test "the same answer computed in other processes"
    (let (old (string/join (map (range 400) (fn (i) (str "row " (math/mod i 11)))) "\n")
          new (string/replace old "row 3" "ROW 3")
          here (diff/line-status old new)
          me (self))
      (map (range 4) (fn (_) (spawn (send me (diff/line-status old new)))))
      (let (answers (fold (range 4) [] (fn (acc _) (conj acc (receive)))))
        (is (> (count here) 30))
        (is (every? answers (fn (answer) (= answer here))))))))
