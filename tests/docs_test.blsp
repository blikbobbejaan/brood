;; Documentation extraction (std/docs.blsp): module docstrings and the
;; load+introspect renderer behind `nest doc`. Register-only — discovered and run
;; by `nest test` (and cargo test, via crates/lisp/tests/suite.rs).

(defmodule docs-test (:use-internals docs) (:use-internals markdown) (:use test) (:use docs))

(describe "docs: leading module docstring"
  (test "the defmodule's docstring is the module doc"
    (assert= (docs/docs-leading-doc "(defmodule m \"Hi.\")\n(def x 1)") "Hi."))
  (test "no defmodule, or one without a docstring, means no module doc"
    (assert= (docs/docs-leading-doc "(def x 1)") nil)
    (assert= (docs/docs-leading-doc "\"Hi.\" (def x 1)") nil)
    (assert= (docs/docs-leading-doc "(defmodule m (:use test))") nil))
  (test "comments before the defmodule are skipped"
    (assert= (docs/docs-leading-doc ";; a comment\n(defmodule m \"Hi.\")\n(def x 1)") "Hi."))
  (test "the baked-in test module carries a module docstring"
    (is (string/starts-with? (or (docs/docs-leading-doc (or (%builtin-module "test") "")) "")
          "A tiny ExUnit"))))

(describe "docs: name attribution (reflect/global-names delta)"
  (test "added names are those in after but not before"
    (assert= (docs/docs-added '(a b) '(a b c d)) '(c d)))
  (test "nothing newly bound is empty" (assert= (docs/docs-added '(a b) '(a b)) nil)))

(describe "docs: classification"
  (test "functions and macros are documentable; plain values are not"
    (defn doc-test-fn (x) x)
    (defmacro doc-test-macro (x) x)
    (is (docs/docs-documentable? doc-test-fn))
    (is (docs/docs-documentable? doc-test-macro))
    (is (docs/docs-documentable? map))
    ; a native/closure builtin is a fn
    (refute (docs/docs-documentable? 42))
    (refute (docs/docs-documentable? "a string"))))

(describe "docs: basename from a path"
  (test "strips the directory and the .blsp suffix"
    (assert= (docs/docs-basename "a/b/foo.blsp") "foo")
    (assert= (docs/docs-basename "foo.blsp") "foo")
    (assert= (docs/docs-basename "foo") "foo")))

;; Fixtures for the deprecated-heading case. Top level, not inside a test body: `(meta …)`
;; resolves its name the way a `def` head does, so written in a body it would key off
;; whatever namespace is current there rather than this module's.
(defn doc-kept (x) "The new way." x)
(defn doc-gone (x) "The old way." x)
;; C15's subjects, at module level because the effect is read from the GLOBAL the name
;; resolves to — a `defn` inside a `test` body is not the same binding a docs build sees.
(defn doc-shouts (s) "Say it." (io/puts s))
(defn doc-inner (s) (io/puts s))
(defn doc-outer (s) "Wrap it." (doc-inner s))
(defn doc-adds (a b) "Add." (+ a b))
(meta doc-gone :deprecated "0.19.0" :use 'doc-kept)

(describe "docs: rendering one definition"
  (test "a documented function renders its signature and docstring"
    (defn doc-squared (x) "Return x times itself." (* x x))
    (assert= (docs/docs-entry 'doc-squared doc-squared)
      "### `(doc-squared x)`\n\nReturn x times itself.\n"))
  (test "a macro entry is tagged"
    (defmacro doc-bump (x) "Add one." `(+ ~x 1))
    (assert= (docs/docs-entry 'doc-bump doc-bump) "### `(doc-bump x)`  *(macro)*\n\nAdd one.\n"))
  (test "an undocumented function gets a placeholder"
    (defn doc-bare (x) (* x x))
    (assert= (docs/docs-entry 'doc-bare doc-bare) "### `(doc-bare x)`\n\n_Undocumented._\n"))
  ;; C15: the checker's purity walk graded a `:pure` DECLARATION and showed nothing
  ;; anywhere. An entry now carries the effect its body REACHES — and only that: the
  ;; effectful-primitive list is a deny-list, so finding none means "not known to perform
  ;; one", never "pure", and a docs page must not claim what the analysis cannot.
  (test "an effectful definition says what effect it reaches"
    (let (entry (docs/docs-entry 'docs-test/doc-shouts docs-test/doc-shouts))
      (is (includes? entry "*Effects:* (io/puts …)"))
      (is (includes? entry "Say it."))))
  (test "an effect through a CALL is described through it"
    (is (includes? (docs/docs-entry 'docs-test/doc-outer docs-test/doc-outer)
          "which performs an effect")))
  (test "a function with no effect gets no Effects line — the absence is not a purity claim"
    (let (entry (docs/docs-entry 'docs-test/doc-adds docs-test/doc-adds))
      (refute (includes? entry "Effects:"))
      (is (includes? entry "Add."))))
  (test "a deprecated definition is STRUCK THROUGH, not merely annotated"
    ;; The note tells a reader who already opened the entry; the strikethrough is what
    ;; tells one who is skimming the module not to reach for the name at all.
    (assert= (docs/docs-entry 'docs-test/doc-gone docs-test/doc-gone)
      (str "### ~~`(docs-test/doc-gone x)`~~\n\n"
        "> **Deprecated** since 0.19.0 — use `doc-kept` instead.\n\n" "`(any) -> any`\n\n"
        "The old way.\n"))
    ;; …and an ordinary name keeps its plain heading.
    (assert= (docs/docs-entry 'docs-test/doc-kept docs-test/doc-kept)
      "### `(docs-test/doc-kept x)`\n\n`(any) -> any`\n\nThe new way.\n")))

(describe "docs: structured model (nest docs)"
  (test "docs-bare strips the module namespace to the last segment"
    (assert= (docs/docs-bare 'http/fetch) "fetch")
    (assert= (docs/docs-bare 'map) "map")
    ; a bare operator name (empty last segment) keeps its whole name
    (assert= (docs/docs-bare '/) "/"))
  (test "a def record carries name, bare signature, docstring, and macro flag"
    (defn model-sq (x) "Square x." (* x x))
    (let (record (docs/docs-def-record 'model-sq model-sq))
      (assert= (get record :name) "model-sq")
      (assert= (get record :sig) "(model-sq x)")
      (assert= (get record :doc) "Square x.")
      (refute (get record :macro))))
  (test "a module model has :module/:doc/:defs; only documentable fns/macros reach :defs"
    (defn model-pub (x) x)
    (def model-val 42)
    ; the syms arrive qualified (as they do from `reflect/global-names`), so eval resolves them;
    ; the plain value is not documentable and is dropped, the function is kept
    (let (model (docs/docs-module-model "m" "Doc." '(docs-test/model-pub docs-test/model-val)))
      (assert= (get model :module) "m")
      (assert= (get model :doc) "Doc.")
      (assert= (count (get model :defs)) 1)
      (assert= (get (first (get model :defs)) :name) "model-pub"))))

;; A `deftype` binds no global, so the module's name walk cannot see it; the docs read
;; the checker's alias store by module instead (`reflect/type-aliases`, ADR-327 follow-up).
;; Top level, like the `meta` fixture: the alias is keyed to THIS module's namespace.
(deftype doc-cell (tuple int int))

(describe "docs: a deftype is documented under Types"
  (test "reflect/type-aliases lists a module's aliases with the type as written"
    (let (aliases (reflect/type-aliases 'docs-test))
      (assert= (count aliases) 1)
      (assert= (get (first aliases) :name) "docs-test/doc-cell")
      (assert= (get (first aliases) :type) "(tuple int int)")))
  (test "the Markdown carries a Types section, bare name over the type"
    (is (includes? (docs/docs-render "docs-test" nil '() "docs-test")
          "## Types\n\n### `doc-cell`\n\n`(tuple int int)`\n\n"))
    ;; …and none when the namespace is unknown (the load-delta fallback)
    (refute (includes? (docs/docs-render "docs-test" nil '()) "## Types")))
  (test "the structured model carries :types the same way"
    (let (model (docs/docs-module-model "docs-test" nil '() "docs-test"))
      (assert= (get model :types) [{:name "doc-cell" :type "(tuple int int)"}]))))

(describe "docs: guides (Markdown → HTML)"
  (test "headings, inline code, links, lists, and fenced code render"
    (assert= (markdown/->html "# Hi") "<h1>Hi</h1>")
    (is (includes? (markdown/->html "a `b` c") "<code>b</code>"))
    (is (includes? (markdown/->html "see [x](/y)") "<a href=\"/y\">x</a>"))
    (is (includes? (markdown/->html "- one\n- two") "<li>one</li>"))
    (is (includes? (markdown/->html "```\n(+ 1 2)\n```") "<pre><code>(+ 1 2)</code></pre>"))
    ; HTML in prose is escaped
    (is (includes? (markdown/->html "a <b> c") "&lt;b&gt;")))
  (test "guide title humanises the filename"
    (assert= (docs/guide-title "guides/getting-started.md") "Getting started")))

(describe "docs: Markdown edge cases (review fixes)"
  (test "an unmatched [ is a literal, not a runaway recursion"
    (assert= (markdown/->html "a [b c") "<p>a [b c</p>")
    (assert= (markdown/->html "cost $[5 today") "<p>cost $[5 today</p>"))
  (test "a link URL is attribute-escaped and javascript: is neutralised"
    (is (includes? (markdown/->html "x [y](\" onx=1)") "&quot;"))
    (is (includes? (markdown/->html "[a](javascript:alert(1))") "href=\"#\"")))
  (test "an unclosed code fence at EOF is emitted, not dropped"
    (is (includes? (markdown/->html "```\n(+ 1 2)") "<pre><code>(+ 1 2)</code></pre>"))))

;; `md-run` — the inline scanner (links, autolinks, emphasis; once `md-links`, links only).
;; Characterisation tests written BEFORE making the
;; function tail-recursive: it had no coverage at all, and it is fiddly index arithmetic over
;; strings, so the rewrite needed something to hold it to. Every case below passed against the
;; original non-tail implementation first.
(describe "docs: md-run"
  (test "text with no bracket is escaped and returned"
    (assert= "plain &lt;b&gt;" (markdown/md-run "plain <b>")))

  (test "a real [text](url) link becomes an anchor"
    (assert= "<a href=\"u\">a</a>" (markdown/md-run "[a](u)")))

  (test "text around a link is preserved and escaped"
    (assert= "x <a href=\"u\">a</a> y" (markdown/md-run "x [a](u) y")))

  (test "two links in one run both render"
    (assert= "<a href=\"u\">a</a><a href=\"v\">b</a>"
      (markdown/md-run "[a](u)[b](v)")))

  (test "a bracket run that is not a link is emitted literally, and scanning continues"
    (assert= "[a] then <a href=\"u\">b</a>" (markdown/md-run "[a] then [b](u)")))

  (test "an unclosed ] escapes the whole run"
    (assert= "[a(u)" (markdown/md-run "[a(u)")))

  (test "an unclosed ) escapes the whole run"
    (assert= "[a](u" (markdown/md-run "[a](u")))

  (test "link text and url are escaped"
    (assert= "<a href=\"u&amp;v\">&lt;t&gt;</a>" (markdown/md-run "[<t>](u&v)")))

  (test "a javascript: url is neutralised"
    ;; The trailing `)` is real, not a bug in the test: `index-of ")"` finds the INNER paren,
    ;; so the url is `javascript:alert(1` and the outer `)` falls through as literal text.
    ;; Nested parens in a url truncate it — pinned here because the security property that
    ;; matters (a `javascript:` url becomes `#`) holds regardless.
    (assert= "<a href=\"#\">x</a>)" (markdown/md-run "[x](javascript:alert(1))")))

  (test "a long run of links all render"
    ;; 2000 links. Recursion depth here is one frame per link, so this is also the shape the
    ;; checker's non-tail-recursion warning is about — though 2000 does NOT overflow, so the
    ;; warning is about headroom, not an observed failure. `string-split` on N separators
    ;; yields N+1 pieces.
    (let (src (apply str (map (range 0 2000) (fn (_) "[a](u)"))))
      (assert= 2001 (count (string/split (markdown/md-run src) "<a href="))))))

;; A Markdown link's URL becomes an `href`. Anything rendering third-party Markdown — a
;; package README on a registry, a dependency's guide in a generated site — is letting
;; whoever wrote it choose that URL, and a scheme that EXECUTES turns a link into script
;; running with the page's own origin.
(describe "markdown links cannot carry an executing scheme"
  (test "javascript: is neutralised"
    ;; `includes?` on the href, not equality on the whole string: the link parser stops at
    ;; the first `)`, so `alert(1))` leaves a stray paren in the text. The href is the claim.
    (is (includes? (markdown/->html "[x](javascript:alert(1))") "href=\"#\""))
    (is (not (includes? (markdown/->html "[x](javascript:alert(1))") "javascript"))))

  ;; A browser matches a scheme case-insensitively, so a check on the literal spelling
  ;; catches only the spelling an attacker would not use.
  (test "and so is every casing of it"
    (is (includes? (markdown/->html "[x](JaVaScRiPt:alert(1))") "href=\"#\""))
    (is (not (includes? (markdown/->html "[x](JaVaScRiPt:alert(1))") "JaVaScRiPt:")))
    (is (includes? (markdown/->html "[x](JAVASCRIPT:alert(1))") "href=\"#\"")))

  (test "vbscript: and data: too — a data: URL is a document with an origin"
    (is (includes? (markdown/->html "[x](vbscript:msgbox(1))") "href=\"#\""))
    (is (includes? (markdown/->html "[x](data:text/html,hi)") "href=\"#\""))
    (is (includes? (markdown/->html "[x](DATA:text/html,hi)") "href=\"#\"")))

  (test "leading whitespace does not smuggle one past the check"
    (is (includes? (markdown/->html "[x](  javascript:alert(1))") "href=\"#\"")))

  (test "ordinary links are untouched"
    (is (includes? (markdown/->html "[x](https://example.com)") "href=\"https://example.com\""))
    (is (includes? (markdown/->html "[x](/relative)") "href=\"/relative\""))
    (is (includes? (markdown/->html "[x](mailto:a@b.com)") "href=\"mailto:a@b.com\""))))
