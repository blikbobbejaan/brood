;;; Automatic binding hygiene (ADR-066 amendment — "Option A").
;;;
;;; A quasiquote template's own `let`/`letrec`/`fn` binders are alpha-renamed to
;;; fresh gensyms by the expander, so a *plain literal* binder (no `#`, no
;;; `(gensym)`) can neither capture nor be captured by caller code spliced in with
;;; `~`/`~@`. Hygiene is the default; `~'name` opts a binder OUT (intentional
;;; anaphora). Complements the already-automatic free-reference hygiene (the
;;; auto-qualifying resolver). See `eval::macros` (`hygiene_rename`).

(defmodule hygiene-test (:use test))

;; The classic capture trap, written with a PLAIN binder `r` — no `#`. Naive
;; expansion would be `(let (r false) (if r r <caller-r>))`, capturing the caller's
;; `r`. Auto-hygiene renames the template's `r`, so the caller's `r` survives.
(defmacro my-or (a b) `(let (r ~a) (if r r ~b)))

;; A plain `fn` param `acc` must not capture caller code spliced into its body.
(defmacro each-inc (body) `(map [1 2 3] (fn (acc) ~body)))

;; letrec + a plain internal loop binder + accumulator — the `defseq` shape,
;; without any `#`.
(defmacro sum-to (n)
  `(letrec (loop (fn (i acc)
                   (if (> i ~n) acc (loop (+ i 1) (+ acc i)))))
     (loop 1 0)))

;; Nested expansion of ONE macro needs DISTINCT binders, or the inner `t` captures
;; the outer: `(dbl (dbl x))`.
(defmacro dbl (x) `(let (t ~x) (+ t t)))

;; Intentional anaphora: `~'it` opts the binder OUT of hygiene, so the caller's
;; branch can reference `it`.
(defmacro aif (test then else) `(let (~'it ~test) (if ~'it ~then ~else)))

;; `#` auto-gensym still works (redundant now, but not broken).
(defmacro still-hash (a b) `(let (r# ~a) (if r# r# ~b)))

(describe "automatic binding hygiene"
  :isolated (test "a plain let binder does not capture a spliced caller binding"
    ;; Without hygiene this returns false (caller's r captured); with it, 99.
    (assert= (let (r 99) (my-or false r)) 99)
    (assert= (my-or false 42) 42)
    (assert= (my-or 7 99) 7))

  (test "a plain fn param does not capture spliced caller code"
    ;; Caller's `acc` (= 100) must be what `~body` sees, not the fn's element param.
    (assert= (let (acc 100) (each-inc (+ acc 1))) (list 101 101 101)))

  (test "letrec internal binders are hygienic"
    (assert= (sum-to 5) 15)
    ;; A caller `loop`/`i`/`acc` in scope must not be captured by the macro's.
    (let (loop 1 i 2 acc 3)
      (assert= (sum-to 4) 10)
      (assert= (+ loop i acc) 6)))

  (test "nested expansion of one macro keeps binders distinct"
    (assert= (dbl (dbl 5)) 20)
    (assert= (dbl (dbl (dbl 2))) 16))

  (test "~'name opts a binder out — anaphora is visible to the caller"
    (assert= (aif 7 (* it 2) :none) 14)
    (assert= (aif false :yes :no) :no))

  (test "auto-gensym #-binders still work"
    (assert= (let (r 1) (still-hash false r)) 1))

  (test "defseq-based sequence ops remain correct"
    (assert= (map (list 1 2 3 4) (fn (x) (* x x))) (list 1 4 9 16))
    (assert= (seq/filter (list 1 2 3 4) (fn (x) (> x 2))) (list 3 4))
    (assert= (seq/reject (list 1 2 3 4) (fn (x) (> x 2))) (list 1 2))))

;; ---- across processes -------------------------------------------------------
;; A hygienic macro must behave identically when its result is built in a spawned
;; process and sent home (deep copy + re-intern by name across per-process heaps).

(defn caps-worker (parent)
  ;; `r` is the caller-side name the naive capture would clobber; must stay 77.
  (send parent (let (r 77) (my-or false r))))

(defn sumto-worker (parent) (send parent (sum-to 10)))

(describe "hygiene across processes"
  :isolated (test "no capture after building the value in another process"
    (let (me (self) _ (spawn (caps-worker me)))
      (assert= (receive) 77)))

  (test "letrec-loop macro result round-trips a send"
    (let (me (self) _ (spawn (sumto-worker me)))
      (assert= (receive) 55))))

;; ---- every binding site of the one pattern grammar (ADR-500) -----------------
;; Each macro binds `a` itself and splices caller code `e`; the caller's own `a` is 10,
;; so a hygienic expansion answers 11 and a capturing one 2.

(defmacro let-vector (e) `(let ([a] [1]) (+ a ~e)))
(defmacro let-map (e) `(let ({:k a} {:k 1}) (+ a ~e)))
(defmacro fn-pattern (e) `((fn ([a]) (+ a ~e)) [1]))
(defmacro match-pattern (e) `(match [1] ([a] (+ a ~e))))
(defmacro match-guard (e) `(match 1 (a :when (= a 1) (+ a ~e)) (_ 0)))
(defmacro match-or (e) `(match [1 1] ((or [a 2] [1 a]) (+ a ~e))))
(defmacro match-pin (e) `(let (a 1) (match 1 (^a (+ a ~e)) (_ 0))))
(defmacro receive-pattern (e) `(do (send (self) [:v 1]) (receive ([:v a] (+ a ~e)))))
(defmacro when-let-binder (e) `(when-let (a 1) (+ a ~e)))
(defmacro if-let-binder (e) `(if-let (a 1) (+ a ~e) 0))
(defmacro if-let-else (e) `(if-let (a nil) 0 (+ 1 ~e)))
(defmacro for-binder (e) `(first (for (a [1] :when (= a 1)) (+ a ~e))))
(defmacro fold-for-binder (e) `(fold-for (s 0 a [1]) (+ s a ~e)))
(defmacro with-binder (e) `(with (a 1) (+ a ~e)))
(defmacro as-binder (e) `(as-> 1 a (+ a ~e)))
(defmacro catch-binder (e) `(try (throw 1) (catch a (+ a ~e))))
(defmacro defn-param (e) `(do (defn hygiene-helper (a) (+ a ~e)) (hygiene-helper 1)))
(defmacro typed-param (e) `((fn (a:int) (+ a ~e)) 1))
;; `{:keys [a]}` names ARE the keys looked up, so they stay literal — renamed, `a` would
;; read `:a__12` and bind nil.
(defmacro keys-read () `(let ({:keys [a]} {:a 1}) a))

(describe "hygiene at every binding site"
  (test "destructuring let and fn binders do not capture"
    (let (a 10)
      (assert= (let-vector a) 11)
      (assert= (let-map a) 11)
      (assert= (fn-pattern a) 11)))
  (test "match, its guard, or-alternatives and a pin"
    (let (a 10)
      (assert= (match-pattern a) 11)
      (assert= (match-guard a) 11)
      (assert= (match-or a) 11)
      (assert= (match-pin a) 11)))
  (test "receive clause patterns"
    (let (a 10) (assert= (receive-pattern a) 11)))
  (test "the standard binding macros"
    (let (a 10)
      (assert= (when-let-binder a) 11)
      (assert= (if-let-binder a) 11)
      (assert= (for-binder a) 11)
      (assert= (fold-for-binder a) 11)
      (assert= (with-binder a) 11)
      (assert= (as-binder a) 11)
      (assert= (catch-binder a) 11)
      (assert= (defn-param a) 11)))
  ;; A renamed param is still shown as written — an arglist, a doc, an arity error read the
  ;; source's name, not `a__60`: `map`'s doc read `(map coll__60 f)` until they did
  ;; (bedit's doc pane caught it).
  (test "a template defn's renamed params still read as written"
    (defn-param 1)
    ;; the macro call above defines it at run time, where the checker cannot see it
    (assert= '(a) (check-allow :unbound (reflect/arglist hygiene-helper)))
    (is (includes? (error-message (try (check-allow :unbound (hygiene-helper)) (catch e e))) "(a)")))
  (test "if-let's else branch is outside its binding"
    ;; The template's `a` is not in scope in `else`, so the caller's `a` arrives there.
    (let (a 10) (assert= (if-let-else a) 11)))
  (test "a typed binder keeps its annotation and its references"
    (let (a 10) (assert= (typed-param a) 11))
    (let (((_ (param) (_ reference _)) _) (reflect/macroexpand `(typed-param 5)))
      (let (name (->string param))
        (is (string/ends-with? name ":int"))
        (assert= (->string reference) (string/drop-suffix name ":int")))))
  (test "a :keys binder still binds by its name"
    (assert= (keys-read) 1)))

(defn pattern-worker (parent) (send parent (let (a 10) (match-or a))))

(describe "pattern hygiene across processes"
  :isolated (test "a destructuring macro's result built in another process"
    (let (me (self) _ (spawn (pattern-worker me)))
      (assert= (receive) 11))))
