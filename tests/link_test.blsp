;; `link` / `unlink` / `proc/trap-exit` — process links (ADR-067), the
;; symmetric, bidirectional cousin of `monitor`. A linked peer's death either
;; arrives as a trappable `[:EXIT pid reason]` (if you `(proc/trap-exit true)`) or — for
;; an abnormal reason — takes you down too (propagation, cascading through links).
;; A `:normal` exit never kills a non-trapping peer.
;;
;; Register-only — each test runs in its own green process on the worker pool, so
;; link/trap/propagate is exercised across cores; the `:isolated` block at the end
;; stresses a propagation chain concurrently.

(defmodule link-test (:use test))

;; file-local worker bodies (tail-recursive — a test runs in a small-stack proc)
; parks forever
(defn lk-park () (receive (:never :x)))
; crash when told
(defn lk-crash-on (sig) (receive (^sig (error "boom"))))
(describe "links: trap-exit delivers [:EXIT], no trap propagates"

  (test "a trapping process gets [:EXIT pid reason] when a linked peer crashes"
    (let (_me (self))
      (proc/trap-exit true)
      (let (p (spawn (lk-crash-on :die)))
        (link p)
        (send p :die)
        (assert= true
          (receive ([:EXIT ^p [:error _]] true))))
      (proc/trap-exit false)))

  (test "a trapping process gets [:EXIT pid :normal] when a linked peer returns"
    (proc/trap-exit true)
    ; The peer waits for `:go` so it's still alive when we `link` it — then returns
    ; `:normal` *after* the link. (A bare `(spawn :ok)` exits immediately and, under
    ; load, can be dead before `link` runs → `:noproc`, not `:normal`.)
    (let (p (spawn (receive (:go :ok))))
      (link p)
      (send p :go)
      (assert= :normal
        (receive ([:EXIT ^p r] r))))
    (proc/trap-exit false))

  (test "linking an already-dead pid notifies immediately with :noproc"
    (proc/trap-exit true)
    (let (p (spawn :ok)
          pm (monitor p))
      ; wait for it to finish
      (receive ([:down ^pm ^p _] :ok) (after *test-wait-ms* :timeout))
      (link p)
      (assert= :noproc
        (receive ([:EXIT ^p r] r))))
    (proc/trap-exit false)))

(describe "links: propagation and unlink"

  (test "a non-trapping linked peer dies when its partner crashes"
    ;; watcher doesn't trap; it's linked to a crasher → it must die too.
    (let (watcher (spawn (do (proc/trap-exit false) (lk-park)))
          wm (monitor watcher))
      (spawn (do (link watcher) (proc/sleep 20) (error "crash")))
      (is (not (= :SURVIVED (receive ([:down ^wm ^watcher _] :died)))))))

  (test "propagation carries the ORIGINATING reason, not a blanket :kill"
    ;; When a linked partner crashes with reason R, a
    ;; non-trapping peer dies with R — so the peer's own monitors learn why
    ;; the tree fell. The crash reason is the structured [:error {…}] map.
    (let (watcher (spawn (do (proc/trap-exit false) (lk-park)))
          wm (monitor watcher))
      (spawn (do (link watcher) (proc/sleep 20) (error "root cause")))
      (let (reason (receive ([:down ^wm ^watcher r] r) (after *test-wait-ms* :timeout)))
        (assert= :error (first reason))
        (assert= "root cause" (get (first (rest reason)) :message)))))

  (test "a propagated death cascades its reason down a link chain"
    ;; a --link-- b --link-- c: a crashes with R; b dies with R (propagated),
    ;; and b's death propagates R again to c — the whole chain reports R.
    (let (me (self)
          c (spawn (do (proc/trap-exit false) (lk-park)))
          cm (monitor c))
      (let (b (spawn (do (proc/trap-exit false) (link c) (send me [:linked (self)]) (lk-park))))
        ; b has linked c
        (receive ([:linked ^b] :ok) (after *test-wait-ms* :timeout))
        (spawn (do (link b) (error "chain root")))
        (let (reason (receive ([:down ^cm ^c r] r) (after *test-wait-ms* :timeout)))
          (assert= :error (first reason))
          (assert= "chain root" (get (first (rest reason)) :message))))))

  (test "a :normal exit does NOT take down a non-trapping linked peer"
    (let (me (self)
          survivor (spawn
                     (do
                       (proc/trap-exit false)
                       ; atomic spawn-link: c is linked before it runs, so its instant
                       ; :normal exit reaches us as :normal (not a racy :noproc that would
                       ; wrongly take down this non-trapping peer).
                       (let (child (spawn-link :ok)
                             child-monitor (monitor child))
                         ; outlive the child's normal exit
                         (receive
                           ([:down ^child-monitor ^child _] :ok)
                           (after *test-wait-ms* :timeout))
                         (send me [:alive (self)])
                         (receive (:stop :ok))))))
      (assert= true
        (receive ([:alive ^survivor] true)))
      (exit survivor :kill)))

  (test "unlink breaks the coupling — a later crash doesn't propagate"
    (let (watcher (spawn (do (proc/trap-exit false) (lk-park)))
          wm (monitor watcher))
      (let (_c (spawn (do
                        (link watcher)
                        (proc/sleep 20)
                        (unlink watcher)
                        (proc/sleep 20)
                        (error "crash"))))
        ;; after unlink, c's crash must NOT kill watcher
        (assert= :still-linked-free
          (receive ([:down ^wm ^watcher _] :propagated) (after 300 :still-linked-free))))
      (exit watcher :kill))))

(describe "links: cascade through a chain"
  :isolated (test "killing the head of a linked chain takes the whole chain down"
    ;; a — b — c linked in a chain (each links the next). Kill a → b dies
    ;; (propagation) → c dies. We monitor c and watch it fall.
    (let (me (self)
          c (spawn (do (proc/trap-exit false) (lk-park)))
          b (spawn (do (proc/trap-exit false) (link c) (send me [:linked (self)]) (lk-park)))
          a (spawn (do (proc/trap-exit false) (link b) (send me [:linked (self)]) (lk-park)))
          cm (monitor c))
      ; both links are in place
      (receive ([:linked ^a] :ok) (after *test-wait-ms* :timeout))
      (receive ([:linked ^b] :ok) (after *test-wait-ms* :timeout))
      ; abnormal (≠ :normal) → propagates b→c
      (exit a :stop)
      (assert= :chain-down
        (receive ([:down ^cm ^c _] :chain-down) (after *test-wait-ms* :timeout))))))
