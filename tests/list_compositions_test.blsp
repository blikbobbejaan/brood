;; tests/list_compositions_test.blsp — `caar` to `cdddr`, the compositions of `first` and
;; `rest` (ADR-447): each is what its letters say, over a list and over a vector.

(defmodule list-compositions-test (:use test))

(def- tree (list (list (list 1 2) 3) (list 4 5) 6 7))

(describe "each composition is its firsts and rests, right to left"
  (test "two deep"
    (assert= (list (list/caar tree) (list/cadr tree) (list/cdar tree) (list/cddr tree))
      (list (list 1 2) (list 4 5) (list 3) (list 6 7))))

  (test "three deep"
    (assert= (list (list/caaar tree)
               (list/caadr tree)
               (list/cadar tree)
               (list/caddr tree)
               (list/cdaar tree)
               (list/cdadr tree)
               (list/cddar tree)
               (list/cdddr tree))
      (list 1 4 3 6 (list 2) (list 5) nil (list 7))))

  (test "cadr and caddr are second and third"
    (assert= (list (list/cadr tree) (list/caddr tree)) (list (second tree) (third tree))))

  (test "over a vector, as first and rest take one"
    (assert= (list (list/cadr [1 2 3]) (list/cddr [1 2 3]) (list/caar [[9] 8])) (list 2 (list 3) 9)))

  (test "past the end is nil, as first of nil is"
    (assert= (list (list/caddr (list 1)) (list/cdddr nil)) (list nil nil))))
