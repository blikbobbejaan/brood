;; tests/support/suite-helpers.blsp — helpers several test files share.
;;
;; Source, not tests (discovery only picks up `*_test.blsp`): a test file opts in with
;; `(:use suite-helpers)`. Only what at least two files used to copy belongs here.

(defmodule suite-helpers
  "Helpers shared by the in-language suite: `settle` drives a function until the JIT has
decided on it, `ascending?` is the span invariant every highlighter test checks,
`sibling-binary` finds the `brood`/`nest` binary next to the runner, and
`queued-while-idle` (with `await-paused`, `take-chunks`, `queued-count` and
`high-water-bound`) measures what a paused reader left queued in this process's mailbox,
`late-messages` counts a socket's stragglers, `next-seed` steps a deterministic generator,
`await-done` waits for workers' `:done`, and `expand-error`, `hint-of` and
`checker-messages` read an error, a reader hint or the checker's diagnostics."
  (:use test))

;; ---- the JIT ----------------------------------------------------------------------

(defn settle (f argc batch rounds)
  "Call `batch` until arity `argc` of `f` is `:native` or `:bailed`, or `rounds` run out;
returns the last state seen. A `:queued` arm is waiting on the compiler thread, which a
loaded machine (a CI runner) can leave behind for a while: that wait is up to ~10 s of its
own (`settle-queued`) and spends no round, so a slow queue reads as slow, not as `:queued`."
  (batch)
  (let (state (settle-queued f argc 1000))
    (cond
      (= state :native) state
      (or (= state :bailed) (= rounds 0))
      ;; Not native: say why on stderr, so a failing `(assert= :native …)` in a CI log
      ;; carries the arm's `:reason` and deopt counts, not just the state.
        (do
          (io/puts (str "settle: " (pr-str f) "/" argc " ended " (pr-str (%jit-arm-state f argc)))
            :to *err*)
          state)
      else (settle f argc batch (- rounds 1)))))

(defn settle-queued (f argc tries)
  "The state of arity `argc` of `f` once a queued compile has finished, waiting up to
`tries` × 10 ms."
  (let (state (get (%jit-arm-state f argc) :state))
    (if (and (= state :queued) (> tries 0))
      (do (proc/sleep 10) (settle-queued f argc (- tries 1)))
      state)))

;; ---- highlighter spans ------------------------------------------------------------

(defn ascending? (spans)
  "True when every `[start end …]` span starts at or after the previous one's end — the
shape a fontify tiler relies on."
  (ascending-from spans -1))

(defn- ascending-from (spans previous-end)
  (or (empty? spans)
    (let (span (first spans))
      (and (>= (first span) previous-end) (ascending-from (rest spans) (second span))))))

;; ---- binaries ---------------------------------------------------------------------

(defn sibling-binary (name)
  "The path of the binary `name` in the running binary's directory or one of its five
nearest ancestors, or nil. A test binary runs from `target/<profile>/deps/` with the binaries
in `target/<profile>/`, but a cross-target build (the sanitizer's) runs the suite from
`target/<triple>/release/build/brood/<hash>/out/`, four levels below them. Only a regular
file counts: one of those ancestors is a directory called `brood`."
  (binary-in-ancestors (path/dirname (or (os/exe-path) "")) name 6))

(defn- binary-in-ancestors (dir name levels)
  (let (candidate (path/join dir name)
        parent (path/dirname dir))
    (cond
      (file/regular? candidate) candidate
      (or (<= levels 1) (= parent dir)) nil
      else (binary-in-ancestors parent name (dec levels)))))

;; ---- mailbox backpressure ---------------------------------------------------------

(def high-water-bound
  ;; a reader's high-water mark (1 MiB) plus one read (64 KiB) of overshoot
  (+ (* 1024 1024) 65536))

(defn queued-count ()
  "How many messages sit in this process's mailbox."
  (or (proc/mailbox-size (self)) 0))

(defn await-paused ()
  "Wait until this process's mailbox holds messages and has stopped growing — the reader
feeding it has reached its budget and paused. Returns the queued count."
  (eventually "the reader pausing on its budget"
    (fn ()
      (let (first-count (queued-count))
        (proc/sleep 25)
        (let (second-count (queued-count))
          (proc/sleep 25)
          (when (and (> first-count 0) (= first-count second-count (queued-count)))
            first-count))))))

(defn take-chunks (tag source n acc)
  "Take exactly `n` queued `[tag source data]` messages; return the data oldest first."
  (if (= n 0)
    (reverse acc)
    (receive
      ([^tag ^source data] (take-chunks tag source (dec n) (cons data acc)))
      (after 20000 (error "take-chunks: a counted chunk never arrived")))))

(defn queued-while-idle (tag source size)
  "Let the reader deliver all it will to an owner that is not reading, then take the
`[tag source data]` chunks sitting in the mailbox. Returns `[total chunks]`, the total
summed with `size` over each chunk."
  (await-paused)
  (let (chunks (take-chunks tag source (queued-count) nil))
    [(reduce chunks 0 (fn (sum chunk) (+ sum (size chunk)))) chunks]))

(defn late-messages (sock wait-ms seen)
  "`seen` plus the messages for `sock` that arrive, each within `wait-ms` of the last."
  (receive
    ([:tcp ^sock _] (late-messages sock wait-ms (inc seen)))
    ([:tcp-closed ^sock] (late-messages sock wait-ms (inc seen)))
    ([:tcp-error ^sock _] (late-messages sock wait-ms (inc seen)))
    (after wait-ms seen)))

;; ---- generated inputs -------------------------------------------------------------

(defn next-seed (seed)
  "The next state of a deterministic generator, and the value to draw from: a non-negative
32-bit int (`rand`'s xorshift32). Every bit is mixed. The LCG the generative tests each
copied (`(* s 1103515245) + 12345 mod 2^31`) was not: its low bit alternated, so a
`(math/rem s 2)` choice took the same branch every other draw."
  (%rand-step (%rand-seed seed)))
(sig next-seed (int -> int))

;; ---- processes ----------------------------------------------------------------------

(defn await-done (n)
  "Wait for `n` `:done` messages, answering `:ok`. A message that has not arrived within
`*test-wait-ms*` of the last raises, so a worker that died fails the test rather than
passing it — whether or not the caller looks at the answer."
  (if (= n 0)
    :ok (receive
      (:done (await-done (dec n)))
      (after *test-wait-ms* (error (str "await-done: " n " :done message(s) never arrived"))))))

;; ---- errors, hints and checker output ---------------------------------------------

(defn expand-error (form)
  "The error message raised evaluating (and so expanding) `form`, or nil if it succeeds."
  (error-of (reflect/eval form)))

(defn hint-of (src)
  "The `:hint` of the error raised reading and evaluating `src`, or nil — nil too when it
raises nothing."
  (try (do (reflect/eval (reflect/read-string src)) nil) (catch e (get e :hint))))

(defn checker-messages (src)
  "The message of every diagnostic the checker reports for source `src`, as a list."
  (map (reflect/check-string-structured src) (fn (diagnostic) (get diagnostic :message))))
